---
import Layout from "../../layouts/Layout.astro";
import PracticeNav from "../../components/PracticeNav.astro";
import PracticeFooter from "../../components/PracticeFooter.astro";
import SectionNav from "../../components/SectionNav.astro";
import { wordCount, offers, notFor, decisionCard } from "../../data/clubBlueprint";

const calendly = "https://calendly.com/adesikan/15min";
const sections = [
  { id: "services", label: "Services" },
  { id: "not-for", label: "Who this is not for" },
  { id: "book", label: "Book a call" },
];
const words = wordCount([offers, notFor, decisionCard]);

const eyebrow = "text-[11px] md:text-xs tracking-[0.22em] uppercase text-[color:var(--color-accent)]";
const sectionLabel = "text-xs md:text-sm tracking-[0.22em] uppercase text-[color:var(--color-muted)]";
const cta = "inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-accent)] hover:text-[color:var(--color-paper)] transition-colors";
const ctaQuiet = "inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-muted)] hover:text-[color:var(--color-paper)] transition-colors";
const pill = "text-[11px] tracking-[0.04em] text-[color:var(--color-muted)] border border-[color:var(--color-line)] px-2.5 py-1 rounded-full";
const chip = "shrink-0 text-[10px] tracking-[0.14em] uppercase text-[color:var(--color-accent)]";
---

<Layout
  title="Services | The Club Data Blueprint | Citizen of Nowhere"
  description="Services from the Club Data Blueprint practice, who this is not for, and the decision card every engagement ends on."
  path="/clubs/services"
>
  <main class="mx-auto max-w-4xl px-6 md:px-10 py-16 md:py-28">
    <PracticeNav current="/clubs" />

    <header class="mb-10">
      <nav aria-label="Breadcrumb" class="mb-8 text-[11px] md:text-xs tracking-[0.14em] uppercase text-[color:var(--color-muted)]" style="font-family: var(--font-display)">
        <a href="/" class="hover:text-[color:var(--color-paper)] transition-colors">Home</a>
        <span aria-hidden="true"> / </span>
        <a href="/clubs" class="hover:text-[color:var(--color-paper)] transition-colors">Clubs</a>
        <span aria-hidden="true"> / </span>
        <span class="text-[color:var(--color-paper)]">Services</span>
      </nav>
      <p class={`${eyebrow} mb-6`} style="font-family: var(--font-display)">The Club Data Blueprint</p>
      <h1 class="text-4xl md:text-6xl leading-[1.04] tracking-tight font-medium" style="font-family: var(--font-serif)">Services</h1>
    </header>

    <SectionNav items={sections} words={words} />

    <section id="services" class="mb-24 md:mb-36 scroll-mt-32">
      <div class="flex items-baseline justify-between mb-10 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Services</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Sized to the problem</span>
      </div>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {offers.map((o) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <div class="flex items-baseline justify-between gap-4 mb-3">
              <h3 class="text-xl md:text-2xl font-medium" style="font-family: var(--font-serif)">{o.name}</h3>
              <span class={chip} style="font-family: var(--font-display)">{o.format}</span>
            </div>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{o.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 border border-[color:var(--color-line)] p-6 md:p-8">
        <h3 class="text-lg md:text-xl font-medium mb-4" style="font-family: var(--font-serif)">{decisionCard.title}</h3>
        <ol class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3">
          {decisionCard.items.map((it, i) => (
            <li class="min-w-0 text-sm text-[color:var(--color-paper)]/80" style="font-family: var(--font-serif)"><span class="block text-xs text-[color:var(--color-accent)] mb-1" style="font-family: var(--font-display)">0{i + 1}</span>{it}</li>
          ))}
        </ol>
      </div>
      <div class="mt-10" style="font-family: var(--font-display)">
        <a href={calendly} target="_blank" rel="noopener" class={cta}>Book a Club Data Blueprint call <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <!-- Who This Is Not For -->
    <section id="not-for" class="mb-24 md:mb-36 scroll-mt-32">
      <div class="flex items-baseline justify-between mb-10 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Who This Is Not For</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Better to say it now</span>
      </div>
      <ul class="space-y-4 max-w-2xl">
        {notFor.map((t) => (
          <li class="pl-5 relative text-base md:text-lg text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)">
            <span class="absolute left-0 top-3 h-px w-3 bg-[color:var(--color-accent)]"></span>{t}
          </li>
        ))}
      </ul>
    </section>

    <!-- Book a call -->
    <section id="book" class="mb-24 md:mb-32 scroll-mt-32 border border-[color:var(--color-line)] p-8 md:p-12">
      <h2 class="text-3xl md:text-4xl font-medium tracking-tight mb-8 max-w-2xl" style="font-family: var(--font-serif)">Start with a Club Data Blueprint.</h2>
      <div class="flex flex-wrap gap-x-8 gap-y-3" style="font-family: var(--font-display)">
        <a href={calendly} target="_blank" rel="noopener" class={cta}>Book a Club Data Blueprint call <span aria-hidden="true">-&gt;</span></a>
        <a href="/practice#contact" class={ctaQuiet}>Send a note <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <PracticeFooter />
  </main>
</Layout>
