---
import Layout from "../../../layouts/Layout.astro";
import PracticeNav from "../../../components/PracticeNav.astro";
import PracticeFooter from "../../../components/PracticeFooter.astro";
import SectionNav from "../../../components/SectionNav.astro";
import { archetypes, offers, archetypeServices, wordCount } from "../../../data/clubBlueprint";

export function getStaticPaths() {
  return archetypes.map((a) => ({ params: { archetype: a.id }, props: { a } }));
}

const { a } = Astro.props;
const calendly = "https://calendly.com/adesikan/15min";

const services = (archetypeServices[a.id] ?? [])
  .map((title) => offers.find((o) => o.name === title))
  .filter((o): o is typeof offers[number] => o !== undefined);

const sections = [
  { id: "problem", label: "Problem" },
  { id: "build", label: "What to build" },
  { id: "first-move", label: "First move" },
  { id: "record", label: "On the record" },
  { id: "services", label: "Services that fit" },
  { id: "book", label: "Book a call" },
];

const words = wordCount([a.name, a.example, a.problem, a.build, a.horizon, a.firstMove, a.evidence, services]);
const shortName = a.name.replace(/^The /, "");
const title = `${a.name} | The Club Data Blueprint | Citizen of Nowhere`;
const description = `${a.example} ${a.problem}`;

const eyebrow = "text-[11px] md:text-xs tracking-[0.22em] uppercase text-[color:var(--color-accent)]";
const sectionLabel = "text-xs md:text-sm tracking-[0.22em] uppercase text-[color:var(--color-muted)]";
const cta = "inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-accent)] hover:text-[color:var(--color-paper)] transition-colors";
const ctaQuiet = "inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-muted)] hover:text-[color:var(--color-paper)] transition-colors";
const chip = "shrink-0 text-[10px] tracking-[0.14em] uppercase text-[color:var(--color-accent)]";
---

<Layout title={title} description={description} path={`/clubs/for/${a.id}`}>
  <main class="mx-auto max-w-4xl px-6 md:px-10 py-16 md:py-28">
    <PracticeNav current="/clubs" />

    <!-- Header -->
    <header class="mb-10">
      <nav aria-label="Breadcrumb" class="mb-8 text-[11px] md:text-xs tracking-[0.14em] uppercase text-[color:var(--color-muted)]" style="font-family: var(--font-display)">
        <a href="/" class="hover:text-[color:var(--color-paper)] transition-colors">Home</a>
        <span aria-hidden="true"> / </span>
        <a href="/clubs" class="hover:text-[color:var(--color-paper)] transition-colors">Clubs</a>
        <span aria-hidden="true"> / </span>
        <span class="text-[color:var(--color-paper)]">For {shortName}</span>
      </nav>
      <p class={`${eyebrow} mb-6`} style="font-family: var(--font-display)">The Club Data Blueprint</p>
      <h1 class="text-4xl md:text-6xl leading-[1.04] tracking-tight font-medium mb-7" style="font-family: var(--font-serif)">{a.name}</h1>
      <p class="text-lg md:text-2xl leading-relaxed text-[color:var(--color-paper)]/80 max-w-2xl" style="font-family: var(--font-serif)">{a.example}</p>
    </header>

    <SectionNav items={sections} words={words} />

    <!-- Problem -->
    <section id="problem" class="mb-24 md:mb-36 scroll-mt-32">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Problem</h2>
      </div>
      <p class="text-lg md:text-xl text-[color:var(--color-paper)]/85 leading-relaxed max-w-2xl" style="font-family: var(--font-serif)">{a.problem}</p>
      <div class="mt-10" style="font-family: var(--font-display)">
        <a href={calendly} target="_blank" rel="noopener" class={cta}>Book a Club Data Blueprint call <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <!-- What to build -->
    <section id="build" class="mb-24 md:mb-36 scroll-mt-32">
      <div class="flex items-baseline justify-between gap-4 mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">What to build</h2>
        <span class={chip} style="font-family: var(--font-display)">{a.horizon}</span>
      </div>
      <ul class="space-y-4 max-w-2xl">
        {a.build.map((b) => (
          <li class="pl-5 relative text-base md:text-lg text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)">
            <span class="absolute left-0 top-3 h-px w-3 bg-[color:var(--color-accent)]"></span>{b}
          </li>
        ))}
      </ul>
    </section>

    <!-- First move -->
    <section id="first-move" class="mb-24 md:mb-36 scroll-mt-32">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">First move</h2>
      </div>
      <p class="text-xl md:text-2xl text-[color:var(--color-accent)] leading-snug max-w-2xl" style="font-family: var(--font-serif)">{a.firstMove}</p>
    </section>

    <!-- On the record -->
    <section id="record" class="mb-24 md:mb-36 scroll-mt-32">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">On the record</h2>
      </div>
      <p class="text-base md:text-lg text-[color:var(--color-paper)]/70 leading-relaxed max-w-2xl" style="font-family: var(--font-serif)">{a.evidence}</p>
      {"link" in a && a.link && (
        <div class="mt-8" style="font-family: var(--font-display)">
          <a href={a.link.href} class={cta}>{a.link.label} <span aria-hidden="true">-&gt;</span></a>
        </div>
      )}
    </section>

    <!-- Services that fit -->
    <section id="services" class="mb-24 md:mb-36 scroll-mt-32">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Services that fit</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {services.map((o) => (
          <div class="min-w-0 bg-[color:var(--color-ink)] p-7 md:p-8">
            <div class="flex items-baseline justify-between gap-4 mb-3">
              <h3 class="text-xl md:text-2xl font-medium" style="font-family: var(--font-serif)">{o.name}</h3>
              <span class={chip} style="font-family: var(--font-display)">{o.format}</span>
            </div>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{o.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-8" style="font-family: var(--font-display)">
        <a href="/clubs/services" class={ctaQuiet}>All services <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <!-- Book a call -->
    <section id="book" class="mb-24 md:mb-32 scroll-mt-32 border border-[color:var(--color-line)] p-8 md:p-12">
      <h2 class="text-3xl md:text-4xl font-medium tracking-tight mb-8 max-w-2xl" style="font-family: var(--font-serif)">Start with a Club Data Blueprint.</h2>
      <div class="flex flex-wrap gap-x-8 gap-y-3" style="font-family: var(--font-display)">
        <a href={calendly} target="_blank" rel="noopener" class={cta}>Book a Club Data Blueprint call <span aria-hidden="true">-&gt;</span></a>
        <a href="/practice#contact" class={ctaQuiet}>Send a note <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <PracticeFooter />
  </main>
</Layout>
