---
import Layout from "../layouts/Layout.astro";
import PracticeNav from "../components/PracticeNav.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import { approach, stageOffers, tiers, stack, heard, pillars, rightsHolder, router, fit } from "../data/practice";

// The method page: how an engagement runs, the stack decision, what the
// first conversation sounds like, and the operating model I build against.

const calendly = "https://calendly.com/adesikan/15min";
const eyebrow = "text-[11px] md:text-xs tracking-[0.22em] uppercase text-[color:var(--color-accent)]";
const sectionLabel = "text-xs md:text-sm tracking-[0.22em] uppercase text-[color:var(--color-muted)]";
const cta = "inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-accent)] hover:text-[color:var(--color-paper)] transition-colors";
const small = "inline-flex items-center gap-2 text-xs md:text-sm text-[color:var(--color-accent)] hover:text-[color:var(--color-paper)] transition-colors";

const toc = [
  { href: "#start", label: "Start from your problem" },
  { href: "#how", label: "How an engagement works" },
  { href: "#stack", label: "The stack decision" },
  { href: "#heard", label: "What I hear first" },
  { href: "#who", label: "Who decides" },
  { href: "#model", label: "The operating model" },
  { href: "#sport", label: "For rights holders" },
  { href: "#vendors", label: "For AI and data companies" },
  { href: "#fit", label: "Who this is for" },
];

// Ownership structure decides whether a group-wide data programme can happen.
const owners = [
  { t: "One controlling owner", d: "A family or principal that controls several clubs. One decision point, so a shared data model can be mandated, funded and enforced across the group. This is where a group-wide programme starts." },
  { t: "A fund-led group", d: "Several investors pooled through a fund, with a board on top. Board time goes to players, transfers and the main sponsor first. A data programme needs a named board sponsor and a case tied to one of those." },
  { t: "A holding company with club vehicles", d: "Different investors behind each club. Data sharing across the group has to be written into each vehicle's agreements before anything can be built." },
];

// What AI and data companies need from sport before it becomes an enterprise channel.
const vendorNeeds = [
  { t: "A reference boardrooms recognise", d: "A named property whose executives other executives already watch, and a result they can repeat in their own words." },
  { t: "A use case at fan scale", d: "One build that reaches real supporters and moves a line the club cares about: matchday, retail, hospitality or a partner renewal." },
  { t: "A route to the enterprise buyer", d: "The club's sponsors and hospitality guests are the first enterprise conversations. The activation has to be designed so the club makes those introductions." },
];
---

<Layout
  title="Approach | Ashwin Desikan, Citizen of Nowhere"
  description="How an engagement with Ashwin Desikan runs: assess, build, run, with the offers that sit under each stage. The buyer-side view of the fan-data stack decision, independent of every vendor."
  path="/approach"
>
  <main class="mx-auto max-w-4xl px-6 md:px-10 py-16 md:py-28">
    <PracticeNav current="/approach" />

    <section class="mb-16 md:mb-24">
      <p class={`${eyebrow} mb-8`} style="font-family: var(--font-display)">Approach</p>
      <h1 class="text-4xl md:text-6xl leading-[1.02] tracking-tight font-medium mb-8" style="font-family: var(--font-serif)">
        Insight before assumption. <span class="text-[color:var(--color-accent)]">Governance before platform.</span>
      </h1>
      <p class="text-lg md:text-xl leading-relaxed text-[color:var(--color-paper)]/80 max-w-2xl" style="font-family: var(--font-serif)">
        Every engagement runs the same three stages, in the same order, whatever the size: assess the estate, build what the roadmap needs, run it through a season. The method is the one I used inside the leagues, and each stage pays for the next.
      </p>
      <nav class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-xs md:text-sm" style="font-family: var(--font-display)" aria-label="On this page">
        {toc.map((t) => <a href={t.href} class="text-[color:var(--color-muted)] hover:text-[color:var(--color-paper)] transition-colors">{t.label}</a>)}
      </nav>
    </section>

    <!-- Start from your problem -->
    <section id="start" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Start from your problem</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Pick the sentence closest to yours</span>
      </div>
      <ul class="divide-y divide-[color:var(--color-line)] border-y border-[color:var(--color-line)]">
        {router.map((r) => (
          <li>
            <a href={r.href} class="group grid md:grid-cols-[1fr_260px] gap-2 md:gap-8 py-4 items-baseline">
              <span class="text-base md:text-lg text-[color:var(--color-paper)]/85 group-hover:text-[color:var(--color-paper)] transition-colors" style="font-family: var(--font-serif)">&ldquo;{r.problem}&rdquo;</span>
              <span class="text-xs md:text-sm text-[color:var(--color-accent)]" style="font-family: var(--font-display)">{r.label} <span aria-hidden="true">-&gt;</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- How an engagement works -->
    <section id="how" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">How an engagement works</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Three stages, the offers beneath</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6">
        {approach.map((a) => (
          <div class="md:border-l border-[color:var(--color-line)] md:pl-5">
            <p class="text-xs text-[color:var(--color-accent)] mb-2" style="font-family: var(--font-display)">{a.num}</p>
            <h3 class="text-2xl md:text-3xl font-medium mb-3" style="font-family: var(--font-serif)">{a.name}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{a.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 divide-y divide-[color:var(--color-line)] border-y border-[color:var(--color-line)]">
        {approach.map((a) => (
          <div class="py-6 grid md:grid-cols-[160px_1fr] gap-4 md:gap-8">
            <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-accent)] pt-1" style="font-family: var(--font-display)">{a.num} &middot; {a.name}</p>
            <div class="divide-y divide-[color:var(--color-line)]">
              {(stageOffers[a.name] ?? []).map((slug) => tiers.find((t) => t.slug === slug)).filter(Boolean).map((t) => (
                <details class="group py-3">
                  <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden flex items-baseline justify-between gap-4">
                    <span class="text-base md:text-lg font-medium group-hover:text-[color:var(--color-accent)] transition-colors" style="font-family: var(--font-serif)">{t!.name}</span>
                    <span class="shrink-0 text-[10px] tracking-[0.14em] uppercase text-[color:var(--color-muted)]" style="font-family: var(--font-display)">{t!.format}</span>
                  </summary>
                  <div class="pt-3 pb-2 grid md:grid-cols-[1fr_240px] gap-4 md:gap-8">
                    <p class="text-sm md:text-base text-[color:var(--color-paper)]/75 leading-relaxed" style="font-family: var(--font-serif)">{t!.items}</p>
                    <div>
                      <p class="text-[10px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-1" style="font-family: var(--font-display)">You get</p>
                      <p class="text-xs md:text-sm text-[color:var(--color-paper)]/70 leading-relaxed mb-3" style="font-family: var(--font-serif)">{t!.output}</p>
                      <a href={`/practice#offer-${t!.slug}`} class={small} style="font-family: var(--font-display)">The full offer <span aria-hidden="true">-&gt;</span></a>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="mt-8 max-w-2xl text-base md:text-lg text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)">One rule runs through all three stages: redesign the workflow before automating it. Putting AI on a broken process only makes the broken process faster.</p>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-2" style="font-family: var(--font-display)">
        <a href="/readiness" class={small}>Start with the free First-Party Index <span aria-hidden="true">-&gt;</span></a>
        <a href="/pricing" class={small}>Compare the return <span aria-hidden="true">-&gt;</span></a>
        <a href="/kit" class={small}>The deployment kit <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <!-- The Stack Decision -->
    <section id="stack" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-6 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">The stack decision</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-accent)]" style="font-family: var(--font-display)">Independent of all of it</span>
      </div>
      <p class="text-base md:text-lg text-[color:var(--color-paper)]/75 max-w-2xl mb-8 leading-relaxed" style="font-family: var(--font-serif)">
        Every rights holder now faces the same choice. Buy a sports-native activation platform. Extend an enterprise CDP. Build warehouse-native. Or accept a vendor&rsquo;s identity graph and rent your own fans back.
      </p>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {stack.map((st) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <h3 class="text-lg md:text-xl font-medium mb-5" style="font-family: var(--font-serif)">{st.cat}</h3>
            <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-accent)] mb-2" style="font-family: var(--font-display)">Good at</p>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/75 mb-5 leading-relaxed" style="font-family: var(--font-serif)">{st.good}</p>
            <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-2" style="font-family: var(--font-display)">Where it breaks</p>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/60 leading-relaxed" style="font-family: var(--font-serif)">{st.breaks}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 space-y-4 max-w-2xl text-base md:text-lg text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)">
        <p>I have been on the buying side of all four. I wrote the requirements, ran the RFP, negotiated the contract, and then owned the implementation. I do not resell anyone&rsquo;s platform and I take no referral fees. Any product advisory I do for a vendor is disclosed in writing, and I never advise a property on a choice where that vendor is in the running.</p>
        <p>Every stack review ends in five verbs: buy, build, connect, simplify and retire. The retire list is usually where the first year's budget comes from, and it is the list a vendor will never write for you.</p>
        <p>Most stack failures are not technology failures. They are governance failures that only surface eighteen months in, when two clubs disagree on what a fan is.</p>
        <p class="text-[color:var(--color-muted)]">There is no right answer, only a right answer for your ownership model, your club autonomy, and your appetite to run engineering.</p>
      </div>
    </section>

    <!-- What I hear -->
    <section id="heard" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">What I hear first</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">In the first conversation</span>
      </div>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {heard.map((h) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-accent)] mb-4" style="font-family: var(--font-display)">{h.label}</p>
            <blockquote class="text-base md:text-lg text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)">{h.quote}</blockquote>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm md:text-base text-[color:var(--color-muted)] max-w-2xl leading-relaxed" style="font-family: var(--font-serif)">
        Different words, one root cause: a business sitting on real audience value without the identity spine, the governance, and the operating model to turn it into revenue.
      </p>
    </section>

    <!-- Who decides -->
    <section id="who" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-6 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Who decides</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-accent)]" style="font-family: var(--font-display)">Before any multi-club or league scope</span>
      </div>
      <p class="text-base md:text-lg text-[color:var(--color-paper)]/75 max-w-2xl mb-8 leading-relaxed" style="font-family: var(--font-serif)">
        Ownership structure decides whether a data programme can happen at all, long before any question of technology. I establish which of these I am talking to in the first conversation.
      </p>
      <div class="grid md:grid-cols-3 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {owners.map((o) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <h3 class="text-lg md:text-xl font-medium mb-3" style="font-family: var(--font-serif)">{o.t}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{o.d}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 space-y-4 max-w-2xl text-base md:text-lg text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)">
        <p>A minority stake decides nothing on its own. In football the money sits in media rights, player trading and the venue, so a fan data programme earns board time when it moves one of those or a sponsor renewal.</p>
        <p class="text-[color:var(--color-muted)]">The exception is a league that already supplies its clubs with apps, websites or approved technology partners. There the league is the buyer, and the clubs follow.</p>
      </div>
    </section>

    <!-- The operating model -->
    <section id="model" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-6 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">The operating model</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-accent)]" style="font-family: var(--font-display)">What I diagnose and build against</span>
      </div>
      <p class="text-base md:text-lg text-[color:var(--color-paper)]/75 max-w-2xl mb-8 leading-relaxed" style="font-family: var(--font-serif)">
        Foundations first, then activation and commerce, then the applied AI and operating model that ship it, all applied to the business of sport and media.
      </p>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {pillars.map((p) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <p class="text-xs text-[color:var(--color-accent)] mb-4" style="font-family: var(--font-display)">{p.num}</p>
            <h3 class="text-xl md:text-2xl font-medium mb-3" style="font-family: var(--font-serif)">{p.title}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 mb-5" style="font-family: var(--font-serif)">{p.desc}</p>
            <ul class="flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <li class="text-[11px] tracking-[0.04em] text-[color:var(--color-muted)] border border-[color:var(--color-line)] px-2.5 py-1 rounded-full" style="font-family: var(--font-display)">{t}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- For rights holders -->
    <section id="sport" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">For leagues, clubs &amp; rights holders</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-accent)]" style="font-family: var(--font-display)">The most under-monetized asset in the building</span>
      </div>
      <div class="grid md:grid-cols-3 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {rightsHolder.map((r) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <h3 class="text-lg md:text-xl font-medium mb-3" style="font-family: var(--font-serif)">{r.t}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{r.d}</p>
          </div>
        ))}
      </div>
            <div class="mt-10 grid md:grid-cols-[220px_1fr] gap-6 md:gap-10 border-t border-[color:var(--color-line)] pt-8">
        <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-accent)]" style="font-family: var(--font-display)">The competition is the product</p>
        <div class="space-y-4 text-base md:text-lg text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)">
          <p>The leagues that grew fastest made the competition itself the product, and invested centrally in telling its story and finding new fans. That needs a central relationship with the fan, which most European leagues do not yet have.</p>
          <p>The data version of football's reset is a league data charter: one identity standard, shared services for the clubs that cannot afford their own, and partner value shared by an agreed rule. It does for fan data what a revenue-sharing agreement does for prize money, and no club gives up its own records.</p>
          <p class="text-[color:var(--color-muted)]">Capital follows predictability. A club that can show revenue per known fan, and a stack with known costs and exit terms, is easier to invest in.</p>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-2" style="font-family: var(--font-display)">
        <a href="/clubs" class={small}>The Club Data Blueprint <span aria-hidden="true">-&gt;</span></a>
        <a href="/federated" class={small}>The federated model, a case study <span aria-hidden="true">-&gt;</span></a>
        <a href="/perspective" class={small}>A field view on the data-centric club <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <!-- For AI and data companies -->
    <section id="vendors" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-6 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">For AI and data companies</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-accent)]" style="font-family: var(--font-display)">Sport as the door to enterprise</span>
      </div>
      <p class="text-base md:text-lg text-[color:var(--color-paper)]/75 max-w-2xl mb-8 leading-relaxed" style="font-family: var(--font-serif)">
        AI and data companies arriving in European sport usually need three things that a sponsorship package does not give them.
      </p>
      <div class="grid md:grid-cols-3 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {vendorNeeds.map((v) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <h3 class="text-lg md:text-xl font-medium mb-3" style="font-family: var(--font-serif)">{v.t}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{v.d}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 space-y-4 max-w-2xl text-base md:text-lg text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)">
        <p>I sat on the buying side of this at MLB and the NFL, where vendors pitched the league and the clubs every week. I know what a league needs to see before it lets a vendor scale across clubs, and how quickly other clubs ask for a platform once one club has proved it.</p>
        <p>For investors, the same work shortens the route from a sports pilot to an enterprise logo for the portfolio companies most likely to win.</p>
        <p class="text-[color:var(--color-muted)]">The rule I keep: when I work for a vendor, I do not advise any property on a choice where that vendor is in the running, and I say so in writing on both sides.</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-2" style="font-family: var(--font-display)">
        <a href="/practice#engage" class={small}>The Sport-to-Enterprise Sprint <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <!-- Fit -->
    <section id="fit" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Who this is for</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">A straight answer either way</span>
      </div>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
          <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-accent)] mb-4" style="font-family: var(--font-display)">A good fit</p>
          <ul class="space-y-3">{fit.yes.map((x) => <li class="pl-6 relative text-sm md:text-base text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)"><span class="absolute left-0 text-[color:var(--color-accent)]" aria-hidden="true">&#10003;</span>{x}</li>)}</ul>
        </div>
        <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
          <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-4" style="font-family: var(--font-display)">Not a fit</p>
          <ul class="space-y-3">{fit.no.map((x) => <li class="pl-6 relative text-sm md:text-base text-[color:var(--color-paper)]/60 leading-relaxed" style="font-family: var(--font-serif)"><span class="absolute left-0 text-[color:var(--color-muted)]" aria-hidden="true">&#10005;</span>{x}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="mb-20 md:mb-28 border border-[color:var(--color-line)] p-8 md:p-12">
      <p class={`${eyebrow} mb-5`} style="font-family: var(--font-display)">Start here</p>
      <h2 class="text-3xl md:text-4xl font-medium tracking-tight mb-5 max-w-2xl" style="font-family: var(--font-serif)">A first call is fifteen minutes and needs no preparation.</h2>
      <div class="flex flex-wrap gap-x-8 gap-y-3" style="font-family: var(--font-display)">
        <a href={calendly} target="_blank" rel="noopener" class={cta}>Book a call <span aria-hidden="true">-&gt;</span></a>
