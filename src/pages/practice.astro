      </div>
    </section>

    <!-- The Index band -->
    <section class="mb-24 md:mb-36 border border-[color:var(--color-line)] p-8 md:p-12">
      <p class={`${eyebrow} mb-5`} style="font-family: var(--font-display)">The First-Party Index</p>
      <h2 class="text-3xl md:text-4xl font-medium tracking-tight mb-5 max-w-2xl" style="font-family: var(--font-serif)">How ready is your first-party data to drive revenue?</h2>
      <p class="text-base md:text-lg text-[color:var(--color-paper)]/75 max-w-2xl mb-8" style="font-family: var(--font-serif)">
        A six-question index drawn from patterns across thirty-plus enterprise engagements. Score your organization across six dimensions and see the shape of your readiness, in under two minutes. No email required.
      </p>
      <a href="/readiness" class={cta} style="font-family: var(--font-display)">Calculate your index <span aria-hidden="true">-&gt;</span></a>
