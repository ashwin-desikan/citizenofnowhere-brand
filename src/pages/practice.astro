    <!-- Currently -->
    <section class="mb-24 md:mb-36">
      <div class="flex items-baseline justify-between mb-10 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Currently</h2>
      </div>
      <p class="text-2xl md:text-4xl leading-snug font-medium max-w-3xl" style="font-family: var(--font-serif)">
        Open to a senior leadership mandate in data, identity, and marketing technology, the kind that <span class="text-[color:var(--color-accent)]">owns the operating model end to end</span>. Full-time, based in New York or London and fluent across US and European teams, with selective advisory alongside. If the problem is interesting, let's talk.
      </p>
