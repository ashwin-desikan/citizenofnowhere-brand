            <span><span class="block text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-1">LinkedIn &middot; Profile</span>Ashwin Desikan</span><span aria-hidden="true">-&gt;</span>
          </a>
          <a href="https://www.linkedin.com/company/citizen-of-nowhere" target="_blank" rel="noopener" class="flex items-center justify-between py-5 text-[color:var(--color-paper)]/85 hover:text-[color:var(--color-accent)] transition-colors">
            <span><span class="block text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-1">LinkedIn &middot; Citizen of Nowhere</span>Company page</span><span aria-hidden="true">-&gt;</span>
          </a>
        </div>
