---
import Layout from "../layouts/Layout.astro";
import PracticeNav from "../components/PracticeNav.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import { proof, tiers, metrics, approach, whyme } from "../data/practice";

// The landing page. One screen per section, six sections. Depth lives on
// /approach, /about, /clubs and /federated.

const calendly = "https://calendly.com/adesikan/15min";

const situations = [
  {
    who: "Leagues, clubs and rights holders",
    line: "You acquire fans at real cost and then cannot recognise the same person across ticketing, the app and the gate.",
    href: "/clubs",
    label: "The Club Data Blueprint",
  },
  {
    who: "Media owners and platforms",
    line: "The first-party audience is the asset on the slide, and the commercial team still cannot sell it to a partner.",
    href: "/approach#stack",
    label: "The Stack Decision",
  },
  {
    who: "Investors and new owners",
    line: "You are taking a playbook written in New York or London to a club in Milan, Seville or Lyon. The fan data is part of the price, and the people who can run it locally are not yet in the building.",
    href: "/clubs#owner",
    label: "The new owner playbook",
  },
  {
    who: "AI and data companies entering sport",
    line: "You need one fan-scale result at a property that boardrooms watch, and the club's own partners as your first enterprise conversations.",
    href: "/approach#vendors",
    label: "Sport as the door to enterprise",
  },
];

const background = [
  { where: "The leagues", names: "NFL \u00b7 MLB", did: "Ran marketing technology, fan identity and data governance across 32 NFL clubs and 30 MLB clubs: the platforms, the consent and data standards, the clean-room roadmap, and the operating model that let competing clubs share." },
  { where: "The platforms", names: "Amazon Ads \u00b7 Spotify \u00b7 Facebook \u00b7 Adform", did: "Built the buying side of the same trade: clean rooms and connected identity for 30-plus Tier 1 advertisers on Amazon Marketing Cloud, and the audience measurement and monetization frameworks behind Spotify's ad business. At Adform, the primary European data lead." },
  { where: "The holding companies", names: "Publicis \u00b7 Digitas \u00b7 Omnicom \u00b7 Annalect \u00b7 GroupM", did: "Client-side data strategy at population scale: product owner of a 220 million-identity CDP for Samsung, and the identity and measurement product suite rolled out across 58 EMEA markets, with client work in the Nordics, Germany, France, Italy and Spain." },
];

const services = [
  { name: "Find out where you stand", body: "A diagnostic of the fan data estate: what it is worth, what is in the way, and the sequence that fixes it. Three weeks, a scored roadmap, and a number the board can hold the programme to.", href: "#engage", label: "The Readiness Diagnostic" },
  { name: "Choose and run the stack", body: "The buyer-side view of a crowded market. Requirements, shortlist, negotiation and the governance that has to come with the contract. I have bought from every category on the list and I am independent of all of them.", href: "/approach#stack", label: "The Stack Decision" },
  { name: "Lead it, or test it", body: "A fractional head of data and identity through a build or a transition, and technical diligence for investors who need to know what a data asset is before the price is set.", href: "#engage", label: "Fractional and diligence" },
];

const proofCards = [
  { eyebrow: "Case study", title: "One fan, thirty-two clubs", body: "How a league unified identity, consent and data standards across 32 independently owned clubs, in the league's own published numbers.", href: "/federated", label: "Read the case study" },
  { eyebrow: "Blueprint", title: "The Club Data Blueprint", body: "A vendor-neutral six-layer architecture with implementation plans for elite clubs, lean clubs, ownership groups and leagues.", href: "/clubs", label: "Read the blueprint" },
  { eyebrow: "Toolkit", title: "The Studio", body: "The instruments I use inside an engagement, on a real backend with synthetic fans: a map of every system that touches a fan, a fan census, a board scoreboard, and a clean room that refuses the wrong question.", href: "https://rankings.citizenofnowhere.org/studio", label: "Open the toolkit", external: true },
];

const whyThree = whyme.filter((w) => ["Operator, not commentator", "Independent of every vendor", "Both sides of the trade"].includes(w.label));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: "https://www.citizenofnowhere.org/practice",
  dateModified: new Date().toISOString().slice(0, 10),
  mainEntity: {
    "@type": "Person",
    name: "Ashwin Desikan",
    alternateName: "Citizen of Nowhere",
    jobTitle: "Identity, Data & Marketing Technology Leader",
    description:
      "Identity, data, and monetization leader and operator across the US, UK, and Europe, from the global holding companies and Amazon, Spotify, and Facebook to the NFL and MLB.",
    image: "https://www.citizenofnowhere.org/ashwin-portrait-web.jpg",
    url: "https://www.citizenofnowhere.org/practice",
    worksFor: { "@type": "Organization", name: "Citizen of Nowhere", url: "https://www.citizenofnowhere.org" },
    workLocation: [
      { "@type": "Place", name: "London, United Kingdom" },
      { "@type": "Place", name: "New York, United States" },
    ],
    sameAs: [
      "https://www.linkedin.com/in/ashwindesikan/",
      "https://www.linkedin.com/company/citizen-of-nowhere",
      "https://citizenofnowhere.substack.com",
    ],
    knowsAbout: [
      "Identity resolution", "Customer data platforms", "Data clean rooms", "Consent and data governance",
      "Marketing technology", "AdTech", "Audience activation", "Marketing measurement and attribution",
      "Commerce media", "Applied AI in marketing", "Sports and media business",
    ],
  },
};

const eyebrow = "text-[11px] md:text-xs tracking-[0.22em] uppercase text-[color:var(--color-accent)]";
const sectionLabel = "text-xs md:text-sm tracking-[0.22em] uppercase text-[color:var(--color-muted)]";
const cta = "inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-accent)] hover:text-[color:var(--color-paper)] transition-colors";
const ctaQuiet = "inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-muted)] hover:text-[color:var(--color-paper)] transition-colors";
const small = "inline-flex items-center gap-2 text-xs md:text-sm text-[color:var(--color-accent)] hover:text-[color:var(--color-paper)] transition-colors";
---

<Layout
  title="Ashwin Desikan | Citizen of Nowhere"
  description="Ashwin Desikan: identity, data, and monetization advisor and operator across the US, UK, and Europe, from the holding companies and Amazon, Spotify, and Facebook to the NFL and MLB. Independent of every platform vendor."
  path="/practice"
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(jsonLd)} />
  <main class="mx-auto max-w-4xl px-6 md:px-10 py-16 md:py-28">
    <PracticeNav current="/practice" />

    <!-- 1. Hero -->
    <section class="mb-20 md:mb-28">
      <div class="grid md:grid-cols-[1fr_200px] lg:grid-cols-[1fr_240px] gap-10 md:gap-14 items-start">
        <div>
          <p class={`${eyebrow} mb-8`} style="font-family: var(--font-display)">Operator and advisor &middot; Data, identity &amp; monetization &middot; London and New York</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl leading-[1.04] tracking-tight font-medium mb-8" style="font-family: var(--font-serif)">
            Ashwin Desikan builds the data, identity and marketing-technology function inside <span class="text-[color:var(--color-accent)]">sports and media businesses</span>.
          </h1>
          <p class="text-lg md:text-xl leading-relaxed text-[color:var(--color-paper)]/80 max-w-2xl" style="font-family: var(--font-serif)">
            I ran it at the NFL and MLB, across 62 clubs. Before that I built the other side of the trade at Amazon Ads and Spotify, and ran client data strategy inside Publicis and Omnicom. I now do the same work for rights holders, media owners and the investors behind them, as an advisor, a fractional lead, or the person who runs the stack decision.
          </p>
          <div class="mt-9 flex flex-wrap gap-x-8 gap-y-3" style="font-family: var(--font-display)">
            <a href={calendly} target="_blank" rel="noopener" class={cta}>Book a 15-minute call <span aria-hidden="true">-&gt;</span></a>
            <a href="#services" class={ctaQuiet}>What I do <span aria-hidden="true">-&gt;</span></a>
          </div>
        </div>
        <a href="/about" class="group block w-40 md:w-full md:mt-12">
          <img src="/ashwin-portrait-web.jpg" alt="Ashwin Desikan" width="900" height="1350" class="w-full rounded-sm border border-[color:var(--color-line)] group-hover:border-[color:var(--color-accent)] transition-colors" />
          <span class="mt-3 block text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] group-hover:text-[color:var(--color-accent)] transition-colors" style="font-family: var(--font-display)">Ashwin Desikan &middot; London / New York</span>
        </a>
      </div>
      <div class="mt-12 pt-6 border-t border-[color:var(--color-line)] flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <span class="text-[10px] tracking-[0.18em] uppercase text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Director and VP roles at</span>
        {proof.filter((p) => !["GroupM", "Omnicom \u00b7 Annalect"].includes(p)).map((p) => <span class="text-base md:text-lg text-[color:var(--color-paper)]/70" style="font-family: var(--font-serif)">{p}</span>)}
      </div>
    </section>

    <!-- 2. Background -->
    <section class="mb-20 md:mb-28">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Background</h2>
        <a href="/about" class="text-xs md:text-sm text-[color:var(--color-muted)] hover:text-[color:var(--color-paper)] transition-colors" style="font-family: var(--font-display)">The full story <span aria-hidden="true">-&gt;</span></a>
      </div>
      <div class="grid md:grid-cols-3 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {background.map((b) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-accent)] mb-2" style="font-family: var(--font-display)">{b.where}</p>
            <p class="text-xs tracking-[0.1em] uppercase text-[color:var(--color-muted)] mb-4" style="font-family: var(--font-display)">{b.names}</p>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)">{b.did}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. What I do -->
    <section id="services" class="mb-20 md:mb-28">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">What I do</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Three kinds of work</span>
      </div>
      <div class="grid md:grid-cols-3 gap-10 md:gap-8">
        {services.map((sv) => (
          <div>
            <h3 class="text-xl md:text-2xl font-medium mb-3" style="font-family: var(--font-serif)">{sv.name}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/75 leading-relaxed mb-4" style="font-family: var(--font-serif)">{sv.body}</p>
            <a href={sv.href} class={small} style="font-family: var(--font-display)">{sv.label} <span aria-hidden="true">-&gt;</span></a>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Who this is for -->
    <section class="mb-20 md:mb-28">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Who this is for</h2>
        <a href="/sectors" class="text-xs md:text-sm text-[color:var(--color-muted)] hover:text-[color:var(--color-paper)] transition-colors" style="font-family: var(--font-display)">All seven kinds of buyer <span aria-hidden="true">-&gt;</span></a>
      </div>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {situations.map((s) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8 flex flex-col">
            <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-accent)] mb-4" style="font-family: var(--font-display)">{s.who}</p>
            <p class="text-base md:text-lg text-[color:var(--color-paper)]/85 leading-relaxed grow" style="font-family: var(--font-serif)">{s.line}</p>
            <a href={s.href} class={`${small} mt-6`} style="font-family: var(--font-display)">{s.label} <span aria-hidden="true">-&gt;</span></a>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Ways to work together (accordion) -->
    <section id="engage" class="mb-20 md:mb-28">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Ways to work together</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Seven offers, sized to the problem</span>
      </div>
      <div class="divide-y divide-[color:var(--color-line)] border-y border-[color:var(--color-line)]">
        {tiers.map((t, i) => (
          <details id={`offer-${t.slug}`} class="group scroll-mt-24" open={i === 0}>
            <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden py-5 flex items-baseline justify-between gap-4">
              <span class="flex items-baseline gap-4">
                <span class="text-xs text-[color:var(--color-accent)] w-6" style="font-family: var(--font-display)">0{i + 1}</span>
                <span class="text-lg md:text-xl font-medium group-hover:text-[color:var(--color-accent)] transition-colors" style="font-family: var(--font-serif)">{t.name}</span>
              </span>
              <span class="shrink-0 text-[10px] tracking-[0.14em] uppercase text-[color:var(--color-muted)]" style="font-family: var(--font-display)">{t.format}</span>
            </summary>
            <div class="pb-7 md:pl-10 grid md:grid-cols-[1fr_280px] gap-6 md:gap-10">
              <div>
                <p class="text-sm md:text-base text-[color:var(--color-paper)]/75 leading-relaxed" style="font-family: var(--font-serif)">{t.items}</p>
                <dl class="mt-5 grid sm:grid-cols-3 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
                  <div class="bg-[color:var(--color-ink)] p-4"><dt class="text-[10px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-1" style="font-family: var(--font-display)">Typical trigger</dt><dd class="text-xs md:text-sm text-[color:var(--color-paper)]/75 leading-relaxed" style="font-family: var(--font-serif)">{t.trigger}</dd></div>
                  <div class="bg-[color:var(--color-ink)] p-4"><dt class="text-[10px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-1" style="font-family: var(--font-display)">You get</dt><dd class="text-xs md:text-sm text-[color:var(--color-paper)]/75 leading-relaxed" style="font-family: var(--font-serif)">{t.output}</dd></div>
                  <div class="bg-[color:var(--color-ink)] p-4"><dt class="text-[10px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-1" style="font-family: var(--font-display)">I need from you</dt><dd class="text-xs md:text-sm text-[color:var(--color-paper)]/75 leading-relaxed" style="font-family: var(--font-serif)">{t.inputs}</dd></div>
                </dl>
                <a href={`/practice?engagement=${t.slug}#contact`} class={`${small} mt-5`} style="font-family: var(--font-display)">Start a conversation about this <span aria-hidden="true">-&gt;</span></a>
              </div>
              <div>
                <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-2" style="font-family: var(--font-display)">You buy this when</p>
                <ul class="space-y-2 mb-4">
                  {t.situations.map((x) => (
                    <li class="pl-5 relative text-sm text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">
                      <span class="absolute left-0 top-2.5 h-px w-3 bg-[color:var(--color-accent)]"></span>{x}
                    </li>
                  ))}
                </ul>
                <a href={t.proof.href} class={small} style="font-family: var(--font-display)">See it built: {t.proof.label} <span aria-hidden="true">-&gt;</span></a>
              </div>
            </div>
          </details>
        ))}
      </div>
      <p class="mt-6 text-sm text-[color:var(--color-muted)] max-w-2xl" style="font-family: var(--font-serif)">
        I resell nothing and take no referral fees. Where I advise a vendor on its product, I disclose it in writing, and I never advise you on a choice where that vendor is in the running. <a href="/approach#start" class="text-[color:var(--color-accent)] hover:text-[color:var(--color-paper)] transition-colors">Start from your problem</a> or read <a href="/approach#fit" class="text-[color:var(--color-accent)] hover:text-[color:var(--color-paper)] transition-colors">who this is not for</a>.
      </p>
    </section>

    <!-- 6. Proof -->
    <section id="proof" class="mb-20 md:mb-28">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Proof</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Built, not described</span>
      </div>
      <div class="grid md:grid-cols-3 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)] mb-px">
        {proofCards.map((c) => (
          <a href={c.href} target={c.external ? "_blank" : undefined} rel={c.external ? "noopener" : undefined} class="bg-[color:var(--color-ink)] p-7 md:p-8 group flex flex-col">
            <p class="text-[11px] tracking-[0.18em] uppercase text-[color:var(--color-accent)] mb-3" style="font-family: var(--font-display)">{c.eyebrow}</p>
            <h3 class="text-xl md:text-2xl font-medium mb-3 group-hover:text-[color:var(--color-accent)] transition-colors" style="font-family: var(--font-serif)">{c.title}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed grow" style="font-family: var(--font-serif)">{c.body}</p>
            <span class={`${small} mt-6`} style="font-family: var(--font-display)">{c.label} <span aria-hidden="true">-&gt;</span></span>
          </a>
        ))}
      </div>
      <div class="grid grid-cols-3 md:grid-cols-6 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {metrics.map((m) => (
          <div class="bg-[color:var(--color-ink)] p-4 md:p-5">
            <p class="text-2xl md:text-3xl font-medium tracking-tight text-[color:var(--color-paper)]" style="font-family: var(--font-serif)">{m.fig}</p>
            <p class="text-[10px] tracking-[0.14em] uppercase text-[color:var(--color-muted)] mt-1" style="font-family: var(--font-display)">{m.label}</p>
          </div>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2" style="font-family: var(--font-display)">
        <a href="/about#impact" class={small}>What each number means <span aria-hidden="true">-&gt;</span></a>
        <a href="/record" class={small}>What the leagues have said since <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <!-- 7. How it works + why me -->
    <section class="mb-20 md:mb-28 grid md:grid-cols-2 gap-12 md:gap-16">
      <div>
        <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
          <h2 class={sectionLabel} style="font-family: var(--font-display)">How it works</h2>
        </div>
        <ol class="space-y-5">
          {approach.map((a) => (
            <li class="grid grid-cols-[32px_1fr] gap-3">
              <span class="text-xs text-[color:var(--color-accent)] pt-1" style="font-family: var(--font-display)">{a.num}</span>
              <div>
                <h3 class="text-lg font-medium" style="font-family: var(--font-serif)">{a.name}</h3>
                <p class="text-sm text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{a.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <a href="/approach" class={`${small} mt-6`} style="font-family: var(--font-display)">The full approach, and the stack decision <span aria-hidden="true">-&gt;</span></a>
      </div>
      <div>
        <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
          <h2 class={sectionLabel} style="font-family: var(--font-display)">Why me</h2>
        </div>
        <ul class="space-y-5">
          {whyThree.map((w) => (
            <li>
              <h3 class="text-lg font-medium text-[color:var(--color-accent)]" style="font-family: var(--font-serif)">{w.label}</h3>
              <p class="text-sm text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{w.body}</p>
            </li>
          ))}
        </ul>
        <a href="/about" class={`${small} mt-6`} style="font-family: var(--font-display)">About Ashwin, and the record <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <!-- 8. Contact -->
    <section id="contact" class="mb-20 md:mb-28">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Contact</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">No preparation needed for a first call</span>
      </div>
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h3 class="text-3xl md:text-4xl font-medium tracking-tight mb-4" style="font-family: var(--font-serif)">Start a conversation.</h3>
          <p class="text-base md:text-lg text-[color:var(--color-paper)]/75 max-w-md mb-5" style="font-family: var(--font-serif)">
            Open to a senior in-house mandate and to selective advisory. London or New York, and comfortable working across both.
          </p>
          <ol class="max-w-md mb-7 space-y-2 text-sm text-[color:var(--color-paper)]/70" style="font-family: var(--font-serif)">
            <li><span class="text-[color:var(--color-accent)] mr-2" style="font-family: var(--font-display)">01</span>Where you are: the estate, the owner and the deadline.</li>
            <li><span class="text-[color:var(--color-accent)] mr-2" style="font-family: var(--font-display)">02</span>The real problem, which is often not the one in the brief.</li>
            <li><span class="text-[color:var(--color-accent)] mr-2" style="font-family: var(--font-display)">03</span>What comes next, including a straight answer if I am not the right fit.</li>
          </ol>
          <form id="contactForm" action="https://formspree.io/f/maqzebor" method="POST" class="flex flex-col gap-3 max-w-md">
            <input type="text" name="name" placeholder="Name" aria-label="Your name" required class="bg-transparent border border-[color:var(--color-line)] rounded-sm px-4 py-3 text-[color:var(--color-paper)] placeholder:text-[color:var(--color-muted)] focus:outline-none focus:border-[color:var(--color-accent)]" style="font-family: var(--font-sans)" />
            <input type="email" name="email" placeholder="Email" aria-label="Your email address" required class="bg-transparent border border-[color:var(--color-line)] rounded-sm px-4 py-3 text-[color:var(--color-paper)] placeholder:text-[color:var(--color-muted)] focus:outline-none focus:border-[color:var(--color-accent)]" style="font-family: var(--font-sans)" />
            <select name="engagement" id="engagementSelect" aria-label="What kind of help?" class="bg-[color:var(--color-ink)] border border-[color:var(--color-line)] rounded-sm px-4 py-3 text-[color:var(--color-paper)] focus:outline-none focus:border-[color:var(--color-accent)]" style="font-family: var(--font-sans)">
              <option value="">What kind of help? (optional)</option>
              {tiers.map((t) => <option value={t.slug}>{t.name}</option>)}
              <option value="role">A senior in-house role</option>
              <option value="other">Something else</option>
            </select>
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
            <textarea name="message" id="messageField" rows="4" placeholder="What are you working on?" aria-label="What are you working on?" required class="bg-transparent border border-[color:var(--color-line)] rounded-sm px-4 py-3 text-[color:var(--color-paper)] placeholder:text-[color:var(--color-muted)] focus:outline-none focus:border-[color:var(--color-accent)] resize-y" style="font-family: var(--font-sans)"></textarea>
            <button type="submit" class="self-start border border-[color:var(--color-accent)] text-[color:var(--color-accent)] hover:bg-[color:var(--color-accent)] hover:text-[color:var(--color-ink)] transition-colors px-6 py-3 text-xs tracking-[0.08em] uppercase rounded-sm" style="font-family: var(--font-display)">Send a note</button>
            <p class="text-xs text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Goes straight to my inbox. Prefer to talk? Book a call.</p>
          </form>
          <p id="formStatus" role="status" class="mt-4 text-sm md:text-base max-w-md hidden" style="font-family: var(--font-serif)"></p>
        </div>
        <div class="divide-y divide-[color:var(--color-line)]" style="font-family: var(--font-display)">
          <a href={calendly} target="_blank" rel="noopener" class="flex items-center justify-between py-5 text-[color:var(--color-paper)]/85 hover:text-[color:var(--color-accent)] transition-colors">
            <span><span class="block text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-1">Book a call</span>15-minute intro call</span><span aria-hidden="true">-&gt;</span>
          </a>
          <a href="https://www.linkedin.com/in/ashwindesikan/" target="_blank" rel="noopener" class="flex items-center justify-between py-5 text-[color:var(--color-paper)]/85 hover:text-[color:var(--color-accent)] transition-colors">
            <span><span class="block text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-1">LinkedIn &middot; Profile</span>Ashwin Desikan</span><span aria-hidden="true">-&gt;</span>
          </a>
          <a href="https://www.linkedin.com/company/citizen-of-nowhere" target="_blank" rel="noopener" class="flex items-center justify-between py-5 text-[color:var(--color-paper)]/85 hover:text-[color:var(--color-accent)] transition-colors">
            <span><span class="block text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-1">LinkedIn &middot; Citizen of Nowhere</span>Company page</span><span aria-hidden="true">-&gt;</span>
          </a>
          <a href="https://citizenofnowhere.substack.com/subscribe" target="_blank" rel="noopener" class="flex items-center justify-between py-5 text-[color:var(--color-paper)]/85 hover:text-[color:var(--color-accent)] transition-colors">
            <span><span class="block text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-muted)] mb-1">Substack &middot; Free</span>Get the field reports by email</span><span aria-hidden="true">-&gt;</span>
          </a>
        </div>
      </div>
    </section>

    <PracticeFooter />
  </main>

  <script is:inline>
    (function () {
      var f = document.getElementById("contactForm"),
        s = document.getElementById("formStatus");
      if (!f || !s) return;
      try {
        var qp = new URLSearchParams(window.location.search);
        var eng = qp.get("engagement"), brief = qp.get("brief");
        var sel = document.getElementById("engagementSelect"), msg = document.getElementById("messageField");
        if (eng && sel) { for (var k = 0; k < sel.options.length; k++) { if (sel.options[k].value === eng) sel.value = eng; } }
        if (brief && msg && !msg.value) msg.value = brief.slice(0, 1500);
      } catch (err) {}
      f.addEventListener("submit", function (e) {
        e.preventDefault();
        var btn = f.querySelector('button[type=submit]'),
          label = btn.textContent;
        btn.disabled = true;
        btn.textContent = "Sending...";
        fetch(f.action, {
          method: "POST",
          body: new FormData(f),
          headers: { Accept: "application/json" },
        })
          .then(function (r) {
            if (r.ok) {
              f.reset();
              f.style.display = "none";
              s.textContent = "Thank you. Your note is on its way, and I will be in touch shortly.";
              s.classList.remove("hidden");
              s.style.color = "var(--color-accent)";
            } else {
              return r.json().then(function (d) {
                throw new Error((d.errors && d.errors.map(function (x) { return x.message; }).join(", ")) || "Something went wrong.");
              });
            }
          })
          .catch(function (err) {
            s.textContent = err.message + " You can also book a call or reach me on LinkedIn.";
            s.classList.remove("hidden");
            s.style.color = "var(--color-accent)";
            btn.disabled = false;
            btn.textContent = label;
          });
      });
    })();
  </script>
</Layout>
