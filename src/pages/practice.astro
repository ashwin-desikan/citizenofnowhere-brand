---
import Layout from "../layouts/Layout.astro";

const proof = [
  "NFL",
  "MLB",
  "Amazon",
  "Spotify",
  "Publicis · Digitas",
  "Omnicom · Annalect",
  "GroupM",
];

const pillars = [
  {
    num: "01",
    title: "Connected Identity & Data Foundations",
    desc: "The plumbing everything else depends on, built for a privacy-first world.",
    tags: ["Identity resolution", "CDP architecture", "Clean rooms", "Consent & governance"],
  },
  {
    num: "02",
    title: "Audience, Activation & Commerce Media",
    desc: "Turning first-party audiences into addressable, measurable revenue.",
    tags: ["Audience strategy", "Cross-channel activation", "Retail & commerce media", "Measurement"],
  },
  {
    num: "03",
    title: "AI-Enabled Marketing & Operating Models",
    desc: "Where applied AI meets the commercial and org design to actually ship it.",
    tags: ["Applied AI", "Commercial model design", "Operating-model design", "Tier 1 client partnership"],
  },
  {
    num: "04",
    title: "Sports & Media Business",
    desc: "Rights-adjacent data strategy and stakeholder work, league to club.",
    tags: ["League & club strategy", "Partnership negotiation", "Live-event data"],
  },
];

const whom = [
  { seg: "Leagues & rights holders", promise: "One governed view of the fan across every club and channel, and the clean-room models to monetize it." },
  { seg: "Media owners & publishers", promise: "A first-party identity and measurement spine that turns audience into durable ad and subscription revenue." },
  { seg: "Holding companies & Tier 1 clients", promise: "Connected identity and commercial models that translate client strategy into measurable growth." },
  { seg: "Sponsors, brands & agencies", promise: "Audience and clean-room infrastructure to choose markets and prove activation value, not just reach." },
  { seg: "Growth-stage AdTech / MarTech", promise: "Product and data foundations, and a go-to-market a buyer will believe." },
  { seg: "Investors", promise: "Technical diligence on AdTech, MarTech, and data targets, from a practitioner who has built the stack." },
];

const tiers = [
  {
    name: "Identity & Monetization Diagnostic",
    format: "Fixed scope · Starts here",
    items: "A real audit of your six readiness dimensions, benchmarked against comparable organizations and delivered as a prioritised roadmap with revenue opportunity sizing. The paid, deeper counterpart to the First-Party Index.",
  },
  {
    name: "Advisory",
    format: "Retainer or project",
    items: "Identity and data strategy, operating-model design, board and advisor seats, and investment diligence.",
  },
  {
    name: "Fractional & interim leadership",
    format: "Embedded",
    items: "Standing in as senior data, identity, or marketing-technology leadership through a build or a transition, without the full-time overhead.",
  },
  {
    name: "Enablement & workshops",
    format: "Fixed engagement",
    items: "Governance design, team enablement, keynotes and board workshops that leave the capability inside the building.",
  },
];

const metrics = [
  { fig: "62", label: "Clubs unified", context: "League-scale identity and customer data platforms across every NFL and MLB club." },
  { fig: "220M+", label: "Identities resolved", context: "Product owner of Samsung's identity-linked CDP on Google Cloud." },
  { fig: "~99%", label: "Data spend cut", context: "Shifting Samsung from third-party to owned data, roughly 700,000 dollars out, while expanding reach." },
  { fig: "+20%", label: "Engagement lift", context: "The Adobe Experience Platform rollout across MLB's 30 clubs." },
  { fig: "+40%", label: "YoY audience revenue", context: "Audience-targeted revenue on Spotify's free tier, across a 500-person sales organization." },
  { fig: "58", label: "Markets activated", context: "Rolling out Annalect's identity and measurement product suite across EMEA." },
];

const heard = [
  {
    label: "Identity",
    quote:
      "We spend heavily to acquire fans and customers, but once they are in we cannot recognize the same person across ticketing, the app, and email. We are marketing to ghosts.",
  },
  {
    label: "Governance",
    quote:
      "Every market and every team built their own data setup. Legal, marketing, and analytics each work from a different version of the truth, and our consent is a patchwork we could not defend.",
  },
  {
    label: "Monetization",
    quote:
      "Our first-party data is obviously an asset, but when a partner asks to collaborate in a clean room we cannot say what we can offer, what to charge, or what we are allowed to share.",
  },
  {
    label: "AI & operating model",
    quote:
      "We piloted AI in marketing and it demoed well, but nothing shipped, because the data underneath it and the operating model around it were not ready.",
  },
];

const highlights = [
  {
    co: "National Football League",
    title: "Identity and governance for a 32-club league",
    blurb:
      "As trusted advisor to all 32 clubs, led the modernization of league-scale identity, data, and AI platforms and defined the enterprise governance framework, privacy, consent, data standards, and cross-club integration, that turned thirty-two independent operations into one scalable operating model.",
  },
  {
    co: "Major League Baseball",
    title: "A customer data platform across all 30 clubs",
    blurb:
      "Owned MLB's marketing-technology and audience-data transformation, a 10 million dollar-plus remit spanning CDP, clean rooms, email, SMS, push, and CTV, and drove the Adobe Experience Platform rollout that lifted audience engagement 20 percent.",
  },
  {
    co: "Amazon Ads",
    title: "Clean rooms and Connected Identity for 30+ global advertisers",
    blurb:
      "Directed more than 30 Tier 1 client partnerships architecting Connected Identity, clean-room, and advanced-measurement solutions on Amazon Marketing Cloud, driving cross-platform data collaboration and multi-million-dollar revenue growth.",
  },
  {
    co: "Spotify",
    title: "Turning first-party audio data into ad revenue",
    blurb:
      "Built the global audience-measurement and monetization frameworks used across a 500-person sales organization, partnering with 40-plus agencies and contributing to a 40 percent year-over-year increase in audience-targeted revenue on the free tier.",
  },
  {
    co: "Digitas, Publicis Groupe",
    title: "Samsung's customer data platform, built at population scale",
    blurb:
      "As VP of Data Strategy on Samsung's US account, led a multi-capability team of 20-plus as product owner of an identity-linked CDP resolving 220 million-plus identities on Google Cloud. The shift from third-party to owned data cut spend by roughly 700,000 dollars, about 99 percent, while expanding addressable reach.",
  },
  {
    co: "Annalect, Omnicom Media Group",
    title: "Identity-linked data products across 58 markets",
    blurb:
      "Led data science, analytics, and insight for Annalect EMEA, architecting and rolling out the suite of identity and measurement products, attribution, custom audiences, lookalike modeling, media-mix and TV attribution, across 58 markets.",
  },
];

const approach = [
  { num: "01", name: "Diagnose", body: "Score first-party readiness across the six dimensions and find the gap that matters most. The First-Party Index is the front door." },
  { num: "02", name: "Architect", body: "Design the identity spine, data foundation, and governance the strategy actually needs, sequenced so each step pays for the next." },
  { num: "03", name: "Activate", body: "Turn audiences into real-time, cross-channel action, and stand up the measurement that ties it back to revenue." },
  { num: "04", name: "Monetize & govern", body: "Build the clean-room and partnership models that monetize first-party data, with consent enforced by default." },
];

const rightsHolder = [
  { t: "Recognize the fan everywhere", d: "One identity across ticketing, the app, email, and the stadium gate, so you stop marketing to ghosts." },
  { t: "Make sponsorship measurable", d: "Clean-room collaboration that proves activation value to partners and lets you price inventory on data, not just reach." },
  { t: "Value rights and catchment", d: "Fan catchment, market selection, and rights valuation grounded in real audience data." },
];

const building = [
  { t: "Civic Audience Intelligence", d: "Licensable datasets, scoring APIs, and dashboards for choosing markets, planning activations, and valuing rights." },
  { t: "Sports Cartography APIs", d: "Club, venue, league, and metro data joined on a single editorial source of truth, for leagues, agencies, and rights holders." },
];

const caseStudies = [
  {
    co: "National Football League",
    role: "Director, Business Relationship Management & MarTech Products",
    points: [
      "Unified fan identity and data across all 32 clubs into one league-scale operating model.",
      "Authored the enterprise governance framework: privacy, consent, data standards, and cross-club integration.",
      "Modernized the league's AI, data, and Connected Identity platforms, with club toolkits and executive readouts that accelerated adoption.",
    ],
  },
  {
    co: "Major League Baseball",
    role: "Director, Marketing Tech & Digital Operations",
    points: [
      "Built a customer data platform across all 30 clubs, a 10 million dollar-plus remit spanning CDP, clean rooms, email, SMS, push, and CTV.",
      "Drove the Adobe Experience Platform rollout that lifted audience engagement 20 percent.",
      "Launched real-time, scan-triggered fan journeys; the Mets pilot deployed 12,000-plus push notifications in a season, with check-in click-through rising from roughly 4 to 9 percent.",
      "Authored the clean-room roadmap to monetize first-party data with sponsorship and media partners.",
    ],
  },
];

const whyme = [
  { label: "Operator, not commentator", body: "I have run the desk inside the leagues and the platforms, owning the operating model, not advising from the outside." },
  { label: "Proof you can use", body: "I build in public. The Global Metro Power Rankings and a working MarTech reference implementation are the studio behind the practice." },
  { label: "A network across the ecosystem", body: "Two decades across leagues, holding companies, and platforms shortens every introduction and deal." },
  { label: "I write and I teach", body: "A point of view on identity, data, and the AI era, published in the open every week." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: "https://citizenofnowhere.org/practice",
  dateModified: new Date().toISOString().slice(0, 10),
  mainEntity: {
    "@type": "Person",
    name: "Ashwin Desikan",
    alternateName: "Citizen of Nowhere",
    jobTitle: "Identity, Data & Marketing Technology Leader",
    description:
      "Identity, data, and monetization leader and operator. Two decades across the US, UK, and Europe, from the global holding companies and Amazon, Spotify, and Facebook to the NFL and MLB.",
    image: "https://citizenofnowhere.org/ashwin-portrait-web.jpg",
    url: "https://citizenofnowhere.org/practice",
    worksFor: {
      "@type": "Organization",
      name: "Citizen of Nowhere",
      url: "https://citizenofnowhere.org",
    },
    workLocation: [
      { "@type": "Place", name: "London, United Kingdom" },
      { "@type": "Place", name: "New York, United States" },
    ],
    sameAs: [
      "https://www.linkedin.com/in/ashwindesikan/",
      "https://www.linkedin.com/company/citizen-of-nowhere",
      "https://citizenofnowhere.substack.com",
    ],
    knowsAbout: [
      "Identity resolution",
      "Customer data platforms",
      "Data clean rooms",
      "Consent and data governance",
      "Marketing technology",
      "AdTech",
      "Audience activation",
      "Marketing measurement and attribution",
      "Commerce media",
      "Applied AI in marketing",
      "Sports and media business",
    ],
  },
};

const navLink = "hover:text-[color:var(--color-paper)] transition-colors";
const eyebrow = "text-[11px] md:text-xs tracking-[0.22em] uppercase text-[color:var(--color-accent)]";
const sectionLabel = "text-xs md:text-sm tracking-[0.22em] uppercase text-[color:var(--color-muted)]";
const cta = "inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-accent)] hover:text-[color:var(--color-paper)] transition-colors";
---

<Layout
  title="Ashwin Desikan | Citizen of Nowhere"
  description="Ashwin Desikan: identity, data, and monetization advisor and operator. Two decades across the US, UK, and Europe, from the holding companies and Amazon, Spotify, and Facebook to the NFL and MLB."
  path="/practice"
  theme="light"
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(jsonLd)} />
  <main class="mx-auto max-w-4xl px-6 md:px-10 py-16 md:py-28">
    <!-- Masthead -->
    <header class="sticky top-0 z-50 -mx-6 md:-mx-10 px-6 md:px-10 py-4 mb-16 md:mb-24 flex items-center justify-between gap-6 bg-[color:var(--color-ink)]/85 backdrop-blur-md border-b border-[color:var(--color-line)]/60">
      <a href="/" class={eyebrow} style="font-family: var(--font-display)">Citizen of Nowhere</a>
      <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 md:gap-x-8 text-xs md:text-sm text-[color:var(--color-muted)] justify-end" style="font-family: var(--font-display)">
        <a href="/" class={navLink}>Home</a>
        <a href="#about" class={navLink}>About</a>
        <a href="#track" class={navLink}>Work</a>
        <a href="#engage" class={navLink}>Engage</a>
        <a href="/perspective" class={navLink}>Perspective</a>
        <a href="/readiness" class={navLink}>The Index</a>
        <a href="#contact" class={navLink}>Contact</a>
      </nav>
    </header>

    <!-- Hero -->
    <section class="mb-24 md:mb-36">
      <p class={`${eyebrow} mb-8`} style="font-family: var(--font-display)">
        Identity-led monetization for rights holders, media &amp; platforms
      </p>
      <h1 class="text-4xl md:text-6xl lg:text-7xl leading-[1.02] tracking-tight font-medium mb-9" style="font-family: var(--font-serif)">
        An operator who has <span class="italic text-[color:var(--color-accent)]">run the desk</span> in sports, AdTech, and identity. Now building what comes next.
      </h1>
      <p class="text-lg md:text-2xl leading-relaxed text-[color:var(--color-paper)]/80 max-w-2xl" style="font-family: var(--font-serif)">
        I am Ashwin Desikan. Two decades in identity, data, and monetization across the US, UK, and Europe, anchored in London and New York.
      </p>
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3" style="font-family: var(--font-display)">
        <a href="#contact" class={cta}>Start a conversation <span aria-hidden="true">-&gt;</span></a>
        <a href="#track" class="inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-muted)] hover:text-[color:var(--color-paper)] transition-colors">Read the work <span aria-hidden="true">-&gt;</span></a>
      </div>
      <p class="mt-8 text-[11px] tracking-[0.14em] uppercase text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Open to a senior mandate &amp; selective advisory &middot; London / New York</p>
    </section>

    <!-- Proof -->
    <section class="mb-24 md:mb-36">
      <p class="text-[11px] tracking-[0.18em] uppercase text-[color:var(--color-muted)] mb-5" style="font-family: var(--font-display)">
        Senior roles across leagues, platforms, and holding companies
      </p>
      <div class="flex flex-wrap gap-x-7 gap-y-3 text-lg md:text-xl text-[color:var(--color-paper)]/70" style="font-family: var(--font-serif)">
        {proof.map((p) => <span>{p}</span>)}
      </div>
    </section>

    <!-- About -->
    <section id="about" class="mb-24 md:mb-36">
      <div class="flex items-baseline justify-between mb-10 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">About</h2>
      </div>
      <div class="grid md:grid-cols-[220px_1fr] gap-10 items-start">
        <img src="/ashwin-portrait-web.jpg" alt="Ashwin Desikan" class="w-48 md:w-full rounded-sm border border-[color:var(--color-line)]" />
        <div class="space-y-5 text-base md:text-lg leading-relaxed text-[color:var(--color-paper)]/80 max-w-2xl" style="font-family: var(--font-serif)">
          <p>
            I hold three passports and have spent over 20 years building the data and identity systems that organizations depend on when they live or die by their audiences. That work has run across the United States, the United Kingdom, and Europe, anchored in the two cities I call home, London and New York. <span class="text-[color:var(--color-accent)]">Citizen of Nowhere</span> is where that orientation becomes public work.
          </p>
          <p>
            The arc runs from bioinformatics at Illumina, through London's early AdTech wave, across European markets with the global holding companies, into the platforms that now define the industry at Amazon, Spotify, and Facebook, and on to the major American sports leagues out of New York. The through-line never changed: treat audiences and places as measurable systems, then build the infrastructure and the commercial model to act on them.
          </p>
          <p>
            Today I do that in two registers. Commercially, advising and leading on identity, data, and monetization on both sides of the Atlantic. And independently, building indices and writing about movement, measurement, and belonging. The phrase was meant as an insult. I kept it, because someone at home in more than one city, loyal to the idea rather than the flag, is not stateless. They simply see more of the map.
          </p>
        </div>
      </div>
    </section>

    <!-- What I Hear -->
    <section class="mb-24 md:mb-36">
      <div class="flex items-baseline justify-between mb-10 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">What I Hear</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">In the first conversation</span>
      </div>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {heard.map((h) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <p class="text-[11px] tracking-[0.16em] uppercase text-[color:var(--color-accent)] mb-4" style="font-family: var(--font-display)">{h.label}</p>
            <blockquote class="text-base md:text-lg text-[color:var(--color-paper)]/80 leading-relaxed" style="font-family: var(--font-serif)">{h.quote}</blockquote>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm md:text-base text-[color:var(--color-muted)] max-w-2xl leading-relaxed" style="font-family: var(--font-serif)">
        Different words, one root cause: a business sitting on real audience value without the identity spine, the governance, and the operating model to turn it into revenue. That is the work below.
      </p>
    </section>

    <!-- What I Do -->
    <section class="mb-24 md:mb-36">
      <div class="flex items-baseline justify-between mb-6 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">What I Do</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-accent)]" style="font-family: var(--font-display)">The First-Party Operating Model</span>
      </div>
      <p class="text-base md:text-lg text-[color:var(--color-paper)]/75 max-w-2xl mb-10 leading-relaxed" style="font-family: var(--font-serif)">
        The framework I diagnose and build against, in sequence. Foundations first, then activation and commerce, then the applied AI and operating model that ship it, all applied to the business of sport and media.
      </p>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {pillars.map((p) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <p class="text-xs text-[color:var(--color-accent)] mb-4" style="font-family: var(--font-display)">{p.num}</p>
            <h3 class="text-xl md:text-2xl font-medium mb-3" style="font-family: var(--font-serif)">{p.title}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 mb-5" style="font-family: var(--font-serif)">{p.desc}</p>
            <ul class="flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <li class="text-[11px] tracking-[0.04em] text-[color:var(--color-muted)] border border-[color:var(--color-line)] px-2.5 py-1 rounded-full" style="font-family: var(--font-display)">{t}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- How an Engagement Works -->
    <section class="mb-24 md:mb-36">
      <div class="flex items-baseline justify-between mb-10 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">How an Engagement Works</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Insight before assumption</span>
      </div>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {approach.map((a) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <p class="text-xs text-[color:var(--color-accent)] mb-3" style="font-family: var(--font-display)">{a.num}</p>
            <h3 class="text-xl md:text-2xl font-medium mb-3" style="font-family: var(--font-serif)">{a.name}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{a.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Who I Help -->
    <section id="who" class="mb-24 md:mb-36">
      <div class="flex items-baseline justify-between mb-10 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Who I Help</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">And what you get</span>
      </div>
      <ul class="divide-y divide-[color:var(--color-line)]">
        {whom.map((w) => (
          <li class="py-5 grid md:grid-cols-[260px_1fr] gap-2 md:gap-10">
            <p class="text-base md:text-lg text-[color:var(--color-paper)]" style="font-family: var(--font-serif)">{w.seg}</p>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{w.promise}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- For Leagues, Clubs & Rights Holders -->
    <section class="mb-24 md:mb-36">
      <div class="flex items-baseline justify-between mb-10 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">For Leagues, Clubs &amp; Rights Holders</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-accent)]" style="font-family: var(--font-display)">The most under-monetized asset in the building</span>
      </div>
      <p class="text-base md:text-lg text-[color:var(--color-paper)]/75 max-w-2xl mb-10 leading-relaxed" style="font-family: var(--font-serif)">
        The fan is the most valuable asset in sport and the one most organizations understand least. I have built the identity and data layer beneath that relationship at league scale, and I am building the tools that value it.
      </p>
      <div class="grid md:grid-cols-3 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {rightsHolder.map((r) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <h3 class="text-lg md:text-xl font-medium mb-3" style="font-family: var(--font-serif)">{r.t}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{r.d}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 mb-5 text-xs tracking-[0.18em] uppercase text-[color:var(--color-accent)]" style="font-family: var(--font-display)">What I am building for this audience</p>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {building.map((b) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <h3 class="text-lg md:text-xl font-medium mb-3" style="font-family: var(--font-serif)">{b.t}</h3>
            <p class="text-sm md:text-base text-[color:var(--color-paper)]/70 leading-relaxed" style="font-family: var(--font-serif)">{b.d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Ways to Work Together -->
    <section id="engage" class="mb-24 md:mb-36">
      <div class="flex items-baseline justify-between mb-10 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Ways to Work Together</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Sized to the problem</span>
      </div>
      <div class="grid md:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {tiers.map((t) => (
          <div class="bg-[color:var(--color-ink)] p-7 md:p-8">
            <div class="flex items-baseline justify-between gap-4 mb-3">
              <h3 class="text-xl md:text-2xl font-medium" style="font-family: var(--font-serif)">{t.name}</h3>
              <span class="shrink-0 text-[10px] tracking-[0.14em] uppercase text-[color:var(--color-accent)]" style="font-family: var(--font-display)">{t.format}</span>
            </div>
