    <!-- Contact -->
    <section id="contact" class="mb-24 md:mb-32">
      <div class="flex items-baseline justify-between mb-10 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Contact</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h3 class="text-3xl md:text-4xl font-medium tracking-tight mb-4" style="font-family: var(--font-serif)">Start a conversation.</h3>
          <p class="text-base md:text-lg text-[color:var(--color-paper)]/75 max-w-md mb-7" style="font-family: var(--font-serif)">
            Whether you are building an identity and data capability, preparing a media business for the AI era, or hiring for the role that does both.
          </p>
          <form id="contactForm" action="https://formspree.io/f/maqzebor" method="POST" class="flex flex-col gap-3 max-w-md">
            <input type="text" name="name" placeholder="Name" aria-label="Your name" required class="bg-transparent border border-[color:var(--color-line)] rounded-sm px-4 py-3 text-[color:var(--color-paper)] placeholder:text-[color:var(--color-muted)] focus:outline-none focus:border-[color:var(--color-accent)]" style="font-family: var(--font-sans)" />
            <input type="email" name="email" placeholder="Email" aria-label="Your email address" required class="bg-transparent border border-[color:var(--color-line)] rounded-sm px-4 py-3 text-[color:var(--color-paper)] placeholder:text-[color:var(--color-muted)] focus:outline-none focus:border-[color:var(--color-accent)]" style="font-family: var(--font-sans)" />
            <textarea name="message" rows="4" placeholder="What are you working on?" aria-label="What are you working on?" required class="bg-transparent border border-[color:var(--color-line)] rounded-sm px-4 py-3 text-[color:var(--color-paper)] placeholder:text-[color:var(--color-muted)] focus:outline-none focus:border-[color:var(--color-accent)] resize-y" style="font-family: var(--font-sans)"></textarea>
            <button type="submit" class="self-start border border-[color:var(--color-accent)] text-[color:var(--color-accent)] hover:bg-[color:var(--color-accent)] hover:text-[color:var(--color-ink)] transition-colors px-6 py-3 text-xs tracking-[0.08em] uppercase rounded-sm" style="font-family: var(--font-display)">Send a note</button>
            <p class="text-xs text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Goes straight to my inbox. Prefer to talk? Book a call.</p>
          </form>
          <p id="formStatus" role="status" class="mt-4 text-sm md:text-base max-w-md hidden" style="font-family: var(--font-serif)"></p>
        </div>
        <div class="divide-y divide-[color:var(--color-line)]" style="font-family: var(--font-display)">
