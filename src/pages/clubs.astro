---
import Layout from "../layouts/Layout.astro";
import PracticeNav from "../components/PracticeNav.astro";
import PracticeFooter from "../components/PracticeFooter.astro";
import { hero, archetypes, offers, configurator, faq, decisionCard, pageMeta } from "../data/clubBlueprint";

const calendly = "https://calendly.com/adesikan/15min";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "The Club Data Blueprint",
  description: pageMeta.description,
  url: "https://www.citizenofnowhere.org/clubs",
  provider: {
    "@type": "Person",
    name: "Ashwin Desikan",
    url: "https://www.citizenofnowhere.org/practice",
  },
  areaServed: ["United Kingdom", "Europe", "United States"],
  audience: {
    "@type": "Audience",
    audienceType: "Football clubs, leagues, and multi-club ownership groups",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Club data services",
    itemListElement: offers.map((o) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: o.name },
    })),
  },
};

const eyebrow = "text-[11px] md:text-xs tracking-[0.22em] uppercase text-[color:var(--color-accent)]";
const sectionLabel = "text-xs md:text-sm tracking-[0.22em] uppercase text-[color:var(--color-muted)]";
const cta = "inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-accent)] hover:text-[color:var(--color-paper)] transition-colors";
const ctaQuiet = "inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-muted)] hover:text-[color:var(--color-paper)] transition-colors";

const deeper = [
  { name: "The Blueprint", sub: "Six layers, one sequence, the six scoreboard measures", href: "/clubs/blueprint" },
  { name: "Services", sub: "Eight engagements. Each ends on one decision card.", href: "/clubs/services" },
  { name: "Evidence", sub: "Field notes, one update five teams, the market map", href: "/clubs/evidence" },
];
---

<Layout
  title={pageMeta.title}
  description={pageMeta.description}
  path={pageMeta.path}
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(jsonLd)} />
  <main class="mx-auto max-w-4xl px-6 md:px-10 py-16 md:py-28">
    <PracticeNav current="/sectors" />

    <!-- Hero -->
    <header class="mb-20 md:mb-28">
      <nav aria-label="Breadcrumb" class="mb-8 text-[11px] md:text-xs tracking-[0.14em] uppercase text-[color:var(--color-muted)]" style="font-family: var(--font-display)">
        <a href="/" class="hover:text-[color:var(--color-paper)] transition-colors">Home</a>
        <span aria-hidden="true"> / </span>
        <a href="/sectors" class="hover:text-[color:var(--color-paper)] transition-colors">Who I work with</a>
        <span aria-hidden="true"> / </span>
        <span class="text-[color:var(--color-paper)]">Clubs</span>
      </nav>
      <p class={`${eyebrow} mb-8`} style="font-family: var(--font-display)">{hero.eyebrow}</p>
      <h1 class="text-4xl md:text-6xl lg:text-7xl leading-[1.02] tracking-tight font-medium mb-9" style="font-family: var(--font-serif)">
        {hero.title}
      </h1>
      <p class="text-lg md:text-2xl leading-relaxed text-[color:var(--color-paper)]/80 max-w-2xl" style="font-family: var(--font-serif)">
        A club is a dozen businesses that share one fan. Ticketing, retail, the app, email and the sponsor deck each hold a piece of that fan, and none holds the whole. The Club Data Blueprint joins them back together in six layers and one sequence. It starts with your club type.
      </p>
      <p class="mt-5 text-base md:text-lg leading-relaxed text-[color:var(--color-accent)] max-w-2xl" style="font-family: var(--font-serif)">
        {hero.accent}
      </p>
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3" style="font-family: var(--font-display)">
        <a href={calendly} target="_blank" rel="noopener" class={cta}>Book a Club Data Blueprint call <span aria-hidden="true">-&gt;</span></a>
        <a href="/sectors" class="inline-flex items-center gap-2 text-sm md:text-base text-[color:var(--color-muted)] hover:text-[color:var(--color-paper)] transition-colors">Not a club? See who else I work with <span aria-hidden="true">-&gt;</span></a>
      </div>
    </header>

    <!-- Doors -->
    <section id="doors" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Start with your club type</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-accent)]" style="font-family: var(--font-display)">Six doors</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-[color:var(--color-line)] border border-[color:var(--color-line)]">
        {archetypes.map((a) => (
          <a href={`/clubs/for/${a.id}`} class="min-w-0 bg-[color:var(--color-ink)] p-6 md:p-7 flex flex-col group">
            <span class="block text-lg md:text-xl font-medium mb-2 group-hover:text-[color:var(--color-accent)] transition-colors" style="font-family: var(--font-serif)">{a.name}</span>
            <span class="block text-sm text-[color:var(--color-muted)] leading-relaxed mb-4" style="font-family: var(--font-serif)">{a.example}</span>
            <span class="mt-auto text-xs text-[color:var(--color-accent)]" style="font-family: var(--font-display)">Open <span aria-hidden="true">-&gt;</span></span>
          </a>
        ))}
      </div>
    </section>

    <section id="decision-card" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="border border-[color:var(--color-line)] p-6 md:p-8">
        <h2 class="text-lg md:text-xl font-medium mb-4" style="font-family: var(--font-serif)">{decisionCard.title}</h2>
        <ol class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3">
          {decisionCard.items.map((it, i) => (
            <li class="min-w-0 text-sm text-[color:var(--color-paper)]/80" style="font-family: var(--font-serif)"><span class="block text-xs text-[color:var(--color-accent)] mb-1" style="font-family: var(--font-display)">0{i + 1}</span>{it}</li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Go deeper -->
    <section id="deeper" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-2 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">Go deeper</h2>
      </div>
      <ul class="divide-y divide-[color:var(--color-line)]">
        {deeper.map((d) => (
          <li>
            <a href={d.href} class="py-5 flex items-baseline justify-between gap-4 group">
              <span class="min-w-0">
                <span class="block text-lg md:text-xl font-medium group-hover:text-[color:var(--color-accent)] transition-colors" style="font-family: var(--font-serif)">{d.name}</span>
                <span class="block mt-1 text-sm md:text-base text-[color:var(--color-muted)]" style="font-family: var(--font-serif)">{d.sub}</span>
              </span>
              <span class="shrink-0 text-xs text-[color:var(--color-accent)]" style="font-family: var(--font-display)" aria-hidden="true">-&gt;</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- The Studio -->
    <section id="studio" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-2 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">The Studio</h2>
      </div>
      <div class="py-5 flex flex-col md:flex-row md:items-baseline md:justify-between gap-3 md:gap-8">
        <p class="text-base md:text-lg max-w-xl leading-relaxed" style="font-family: var(--font-serif)">The blueprint is built, not just drawn. Each layer has a working demo.</p>
        <div class="flex flex-wrap gap-x-6 gap-y-2 shrink-0" style="font-family: var(--font-display)">
          <a href="https://rankings.citizenofnowhere.org/studio" target="_blank" rel="noopener" class={cta}>Open the Studio <span aria-hidden="true">-&gt;</span></a>
          <a href={configurator.href} target="_blank" rel="noopener" class={ctaQuiet}>Open the configurator <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="mb-20 md:mb-28 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-2 pb-4 border-b border-[color:var(--color-line)]">
        <h2 class={sectionLabel} style="font-family: var(--font-display)">FAQ</h2>
        <span class="text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Questions clubs ask first</span>
      </div>
      <div class="divide-y divide-[color:var(--color-line)] border-b border-[color:var(--color-line)]">
        {faq.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden flex items-baseline justify-between gap-4 text-base md:text-lg font-medium group-hover:text-[color:var(--color-accent)] transition-colors" style="font-family: var(--font-serif)">
              <span>{f.q}</span>
              <span aria-hidden="true" class="text-[color:var(--color-accent)] group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 max-w-2xl text-sm md:text-base text-[color:var(--color-paper)]/75 leading-relaxed" style="font-family: var(--font-serif)">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Contact band -->
    <section id="contact" class="mb-24 md:mb-32 border border-[color:var(--color-line)] p-8 md:p-12 scroll-mt-24">
      <h2 class="text-3xl md:text-4xl font-medium tracking-tight mb-8 max-w-2xl" style="font-family: var(--font-serif)">Start with a Club Data Blueprint.</h2>
      <div class="flex flex-wrap gap-x-8 gap-y-3" style="font-family: var(--font-display)">
        <a href={calendly} target="_blank" rel="noopener" class={cta}>Book a Club Data Blueprint call <span aria-hidden="true">-&gt;</span></a>
        <a href="/practice#contact" class={ctaQuiet}>Send a note <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <!-- Footer -->
    <PracticeFooter />
  </main>

  <script is:inline>
    (function () {
      var h = (location.hash || "").replace("#", "");
      var map = {
        blueprint: "/clubs/blueprint",
        services: "/clubs/services",
        work: "/clubs/evidence#work",
        "one-update": "/clubs/evidence#one-update",
        "field-note": "/clubs/evidence#field-note",
        archetypes: "#doors",
        owner: "/clubs/for/owner"
      };
      if (h && Object.prototype.hasOwnProperty.call(map, h)) location.replace(map[h]);
    })();
  </script>
</Layout>
