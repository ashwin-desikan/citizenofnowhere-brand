---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="The First-Party Index | Citizen of Nowhere"
  description="How ready is your first-party data to drive revenue? A six-question index scoring your organization across identity, governance, activation, measurement, and monetization. Under two minutes, no email required."
  path="/readiness"
>
  <main class="mx-auto max-w-4xl px-6 md:px-10 py-16 md:py-28">
    <!-- Masthead -->
    <header class="flex items-center justify-between mb-16 md:mb-20 gap-6">
      <a href="/" class="text-[11px] md:text-xs tracking-[0.22em] uppercase text-[color:var(--color-accent)]" style="font-family: var(--font-display)">Citizen of Nowhere</a>
      <a href="/practice" class="text-xs md:text-sm text-[color:var(--color-muted)] hover:text-[color:var(--color-paper)] transition-colors" style="font-family: var(--font-display)">&larr; Back</a>
    </header>

    <!-- Hero -->
    <section class="max-w-2xl mb-10 md:mb-12">
      <p class="text-[11px] md:text-xs tracking-[0.22em] uppercase text-[color:var(--color-accent)] mb-7" style="font-family: var(--font-display)">A Citizen of Nowhere index</p>
      <h1 class="text-5xl md:text-7xl leading-[0.98] tracking-tight font-medium mb-7" style="font-family: var(--font-serif)">The First-Party Index</h1>
      <p class="text-lg md:text-xl leading-relaxed text-[color:var(--color-paper)]/80" style="font-family: var(--font-serif)">
        How ready is your first-party data to drive revenue? Six questions, scored into a single index across the dimensions that actually predict success in identity and monetization. See the shape of your readiness, and where the biggest gap is. No email required.
      </p>
      <p class="mt-6 text-xs tracking-[0.04em] text-[color:var(--color-muted)]" style="font-family: var(--font-display)">Under two minutes &middot; Instant result</p>
    </section>

    <div id="sc" class="max-w-2xl">
      <form id="scorecard"></form>
      <div class="actions">
        <button class="sbtn" id="submit" disabled>Calculate my index</button>
        <span class="progress" id="progress">0 of 6 answered</span>
      </div>

      <section class="result" id="result">
        <div class="band-eyebrow">Your First-Party Index</div>
        <div class="resultgrid">
          <div>
            <div class="indexnum"><span id="indexNum">0</span><span class="slash"> / 100</span></div>
            <span class="band" id="bandName"></span>
            <span class="band-sub" id="bandSub"></span>
          </div>
          <div class="radar" id="radar"></div>
        </div>
        <p class="read" id="readout"></p>
        <div class="gap">
          <div class="lbl">Your biggest opportunity</div>
          <h3 id="gapTitle"></h3>
          <p id="gapText"></p>
        </div>
        <div class="cta">
          <a class="solid" href="https://calendly.com/adesikan/15min" target="_blank" rel="noopener">Talk through your index -&gt;</a>
          <a class="ghost" id="retake">Recalculate</a>
        </div>
        <p class="disc">This is a directional index, not an audit. The scoring reflects what tends to predict success when organizations invest in identity and first-party data; a real engagement goes a level deeper.</p>
      </section>
    </div>

    <!-- Footer -->
    <footer class="mt-24 pt-10 border-t border-[color:var(--color-line)]">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-xs md:text-sm text-[color:var(--color-muted)]" style="font-family: var(--font-display)">
        <span>&copy; {new Date().getFullYear()} Citizen of Nowhere</span>
        <span>the independent work of Ashwin Desikan</span>
      </div>
    </footer>
  </main>

  <style is:global>
    #sc .q { padding: 30px 0; border-top: 1px solid var(--color-line); }
    #sc .qnum { font-family: var(--font-display); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 10px; }
    #sc .q h2 { font-family: var(--font-serif); font-size: 21px; font-weight: 500; line-height: 1.3; margin-bottom: 18px; color: var(--color-paper); }
    #sc .opt { display: block; position: relative; padding: 14px 16px 14px 46px; margin-bottom: 9px; border: 1px solid var(--color-line); border-radius: 4px; cursor: pointer; font-size: 15.5px; color: rgba(245,244,238,.78); font-family: var(--font-serif); transition: border-color .15s, background .15s; }
    #sc .opt:hover { border-color: var(--color-muted); }
    #sc .opt input { position: absolute; left: 15px; top: 17px; accent-color: var(--color-accent); }
    #sc .opt.sel { border-color: var(--color-accent); color: var(--color-paper); }
    #sc .actions { margin-top: 32px; display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
    #sc .sbtn { font-family: var(--font-display); padding: 13px 26px; border: 1px solid var(--color-accent); background: transparent; color: var(--color-accent); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; border-radius: 3px; cursor: pointer; transition: all .2s; }
    #sc .sbtn:hover:not(:disabled) { background: var(--color-accent); color: var(--color-ink); }
    #sc .sbtn:disabled { opacity: .4; cursor: not-allowed; }
    #sc .progress { font-family: var(--font-display); font-size: 13px; color: var(--color-muted); }
    #sc .result { display: none; padding: 40px 0 10px; border-top: 1px solid var(--color-accent); margin-top: 16px; }
    #sc .result.show { display: block; }
    #sc .band-eyebrow { font-family: var(--font-display); font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 18px; }
    #sc .resultgrid { display: grid; grid-template-columns: 1fr 360px; gap: 36px; align-items: center; }
    @media (max-width: 680px) { #sc .resultgrid { grid-template-columns: 1fr; gap: 20px; } }
    #sc .indexnum { font-family: var(--font-serif); font-size: 84px; font-weight: 600; line-height: .9; letter-spacing: -.03em; color: var(--color-paper); }
    #sc .indexnum .slash { font-size: 30px; color: var(--color-muted); letter-spacing: 0; }
    #sc .band { display: block; font-family: var(--font-serif); font-size: 30px; font-weight: 600; margin-top: 14px; color: var(--color-paper); }
    #sc .band-sub { font-family: var(--font-display); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-muted); margin-top: 8px; }
    #sc .radar { display: flex; justify-content: center; }
    #sc .radar svg { width: 100%; max-width: 360px; height: auto; }
    #sc .read { margin-top: 30px; font-family: var(--font-serif); font-size: 18px; color: rgba(245,244,238,.8); line-height: 1.62; max-width: 64ch; }
    #sc .gap { margin-top: 26px; padding: 24px; border: 1px solid var(--color-line); border-radius: 6px; }
    #sc .gap .lbl { font-family: var(--font-display); font-size: 11.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 8px; }
    #sc .gap h3 { font-family: var(--font-serif); font-size: 20px; font-weight: 600; margin-bottom: 8px; color: var(--color-paper); }
    #sc .gap p { font-family: var(--font-serif); color: rgba(245,244,238,.75); font-size: 16px; }
    #sc .cta { margin-top: 32px; display: flex; gap: 18px; flex-wrap: wrap; align-items: center; }
    #sc .cta .solid { font-family: var(--font-display); border: 1px solid var(--color-accent); color: var(--color-accent); padding: 13px 26px; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; border-radius: 3px; transition: all .2s; }
    #sc .cta .solid:hover { background: var(--color-accent); color: var(--color-ink); }
    #sc .cta .ghost { font-family: var(--font-display); font-size: 13px; color: var(--color-muted); border-bottom: 1px solid var(--color-accent); padding-bottom: 3px; cursor: pointer; }
    #sc .disc { margin-top: 28px; font-family: var(--font-serif); font-size: 13px; color: var(--color-muted); font-style: italic; max-width: 64ch; }
  </style>

  <script is:inline>
    (function () {
      var QUESTIONS = [
        { dim: "Data foundation", short: "Data", q: "How unified is your customer or fan data today?", opts: ["Siloed across systems, no single view", "Partly unified for a few use cases", "A working single profile for most of the business", "A governed, real-time single profile powering activation"] },
        { dim: "Identity & addressability", short: "Identity", q: "How addressable is your audience for your own marketing and for partners?", opts: ["Mostly anonymous, reliant on third-party data", "Some first-party matchable audiences", "Broad first-party addressability via an ID partner", "Durable, privacy-safe identity resolved across channels"] },
        { dim: "Consent & governance", short: "Consent", q: "How mature is your consent and data governance?", opts: ["Ad hoc, not really enforced", "Documented but manually enforced", "Centralized policies, mostly automated", "Automated enforcement to every destination"] },
        { dim: "Activation", short: "Activation", q: "Once you have an audience, how well can you act on it?", opts: ["Batch exports, slow and manual", "Some automated activation to key channels", "Cross-channel activation from one place", "Real-time, event-triggered activation at scale"] },
        { dim: "Measurement", short: "Measurement", q: "How well do you measure outcomes back to spend?", opts: ["Channel-level reporting only", "Some cross-channel measurement", "Multi-touch or media-mix modeling in place", "Closed-loop attribution to revenue"] },
        { dim: "Monetization", short: "Monetization", q: "Are you monetizing first-party data with partners?", opts: ["Not yet", "Exploring clean rooms or partnerships", "Live data collaborations with a few partners", "A scaled, governed data-monetization model"] }
      ];
      var GAPS = {
        "Data foundation": "Start with a unified profile. Without a single source of truth, every downstream effort compounds the same gaps.",
        "Identity & addressability": "Build a first-party identity spine. It is now the precondition for both reach and measurement as third-party signal disappears.",
        "Consent & governance": "Automate consent enforcement. Manual governance does not scale and is usually the largest compliance risk.",
        "Activation": "Close the gap between insight and action. Audiences you cannot activate in real time leave revenue on the table.",
        "Measurement": "Move toward closed-loop attribution. You cannot optimize what you cannot tie back to revenue.",
        "Monetization": "Stand up a clean-room strategy. First-party data is an asset, and most organizations under-monetize it."
      };
      var BANDS = [
        { min: 0, name: "Exposed", sub: "Reliant on borrowed signal", read: "Your advantage today rests largely on data you do not own, which is the position the whole market is moving away from. The highest-leverage work is foundational: a single profile and the governance around it. Build that and everything above it gets easier." },
        { min: 25, name: "Building", sub: "Laying the foundation", read: "You have real momentum in places, but capability is uneven. The priority now is connecting the pieces so data, activation, and measurement reinforce each other instead of running in parallel." },
        { min: 50, name: "Compounding", sub: "Advantage starting to stack", read: "You operate a capable stack and your first-party position is starting to compound. The opportunity is leverage: tightening measurement, scaling activation, and turning data into a commercial asset rather than a cost center." },
        { min: 75, name: "Decisive", sub: "A durable, owned edge", read: "You are operating at the front of the field, with an owned data advantage that is hard to copy. The frontier from here is monetization, AI-enabled decisioning, and governance that keeps the edge as the ecosystem shifts." }
      ];
      var RAWMAX = QUESTIONS.length * 3;

      var form = document.getElementById("scorecard");
      QUESTIONS.forEach(function (item, i) {
        var q = document.createElement("div");
        q.className = "q";
        q.innerHTML = '<div class="qnum">Question ' + (i + 1) + " of " + QUESTIONS.length + '</div><h2>' + item.q + "</h2>";
        item.opts.forEach(function (o, j) {
          var lab = document.createElement("label");
          lab.className = "opt";
          lab.innerHTML = '<input type="radio" name="q' + i + '" value="' + j + '"> ' + o;
          lab.querySelector("input").addEventListener("change", function () {
            q.querySelectorAll(".opt").forEach(function (el) { el.classList.remove("sel"); });
            lab.classList.add("sel");
            updateProgress();
          });
          q.appendChild(lab);
        });
        form.appendChild(q);
      });

      function answered() {
        return QUESTIONS.map(function (_, i) {
          var c = form.querySelector('input[name="q' + i + '"]:checked');
          return c ? parseInt(c.value) : null;
        });
      }
      function updateProgress() {
        var a = answered().filter(function (v) { return v !== null; }).length;
        document.getElementById("progress").textContent = a + " of " + QUESTIONS.length + " answered";
        document.getElementById("submit").disabled = a < QUESTIONS.length;
      }

      function radar(values) {
        var cx = 210, cy = 165, R = 115, N = values.length, lblR = R + 22;
        function ang(i) { return (-90 + (i * 360) / N) * Math.PI / 180; }
        function pt(i, r) { return [cx + Math.cos(ang(i)) * r, cy + Math.sin(ang(i)) * r]; }
        var grid = "";
        for (var lvl = 1; lvl <= 3; lvl++) {
          var r = (R * lvl) / 3, pts = [];
          for (var i = 0; i < N; i++) { var p = pt(i, r); pts.push(p[0].toFixed(1) + "," + p[1].toFixed(1)); }
          grid += '<polygon points="' + pts.join(" ") + '" fill="none" stroke="var(--color-line)" stroke-width="1"/>';
        }
        var axes = "";
        for (var i = 0; i < N; i++) { var p = pt(i, R); axes += '<line x1="' + cx + '" y1="' + cy + '" x2="' + p[0].toFixed(1) + '" y2="' + p[1].toFixed(1) + '" stroke="var(--color-line)" stroke-width="1"/>'; }
        var dpts = [];
        for (var i = 0; i < N; i++) { var rr = (R * values[i]) / 3, p = pt(i, rr); dpts.push(p[0].toFixed(1) + "," + p[1].toFixed(1)); }
        var data = '<polygon points="' + dpts.join(" ") + '" fill="rgba(94,234,212,0.15)" stroke="var(--color-accent)" stroke-width="2" stroke-linejoin="round"/>';
        var dots = "";
        for (var i = 0; i < N; i++) { var rr = (R * values[i]) / 3, p = pt(i, rr); dots += '<circle cx="' + p[0].toFixed(1) + '" cy="' + p[1].toFixed(1) + '" r="3.6" fill="var(--color-accent)"/>'; }
        var labels = "";
        for (var i = 0; i < N; i++) {
          var p = pt(i, lblR), anchor = "middle";
          if (p[0] > cx + 6) anchor = "start"; else if (p[0] < cx - 6) anchor = "end";
          labels += '<text x="' + p[0].toFixed(1) + '" y="' + (p[1] + 4).toFixed(1) + '" text-anchor="' + anchor + '" font-size="11.5" fill="var(--color-muted)" font-family="\'JetBrains Mono\', monospace" letter-spacing="0.04em">' + QUESTIONS[i].short + "</text>";
        }
        return '<svg viewBox="0 0 420 340" role="img" aria-label="Readiness profile across six dimensions">' + grid + axes + data + dots + labels + "</svg>";
      }

      document.getElementById("submit").addEventListener("click", function () {
        var a = answered();
        if (a.indexOf(null) !== -1) return;
        var raw = a.reduce(function (s, v) { return s + v; }, 0);
        var index = Math.round((raw / RAWMAX) * 100);
        var band = BANDS.slice().reverse().find(function (b) { return index >= b.min; });
        var wi = 0;
        for (var i = 1; i < a.length; i++) { if (a[i] < a[wi]) wi = i; }
        var dim = QUESTIONS[wi].dim;

        var numEl = document.getElementById("indexNum"), cur = 0, step = Math.max(1, Math.round(index / 28));
        numEl.textContent = 0;
        (function tick() { cur = Math.min(index, cur + step); numEl.textContent = cur; if (cur < index) requestAnimationFrame(tick); })();

        document.getElementById("bandName").textContent = band.name;
        document.getElementById("bandSub").textContent = band.sub;
        document.getElementById("readout").textContent = band.read;
        document.getElementById("gapTitle").textContent = dim;
        document.getElementById("gapText").textContent = GAPS[dim];
        document.getElementById("radar").innerHTML = radar(a);

        document.getElementById("result").classList.add("show");
        document.getElementById("result").scrollIntoView({ behavior: "smooth" });
      });

      document.getElementById("retake").addEventListener("click", function (e) {
        e.preventDefault();
        form.querySelectorAll("input").forEach(function (el) { el.checked = false; });
        form.querySelectorAll(".opt").forEach(function (el) { el.classList.remove("sel"); });
        document.getElementById("result").classList.remove("show");
        updateProgress();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    })();
  </script>
</Layout>
