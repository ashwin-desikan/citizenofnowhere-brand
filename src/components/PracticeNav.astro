---
// Shared masthead for the practice pages. Six links, no more: the depth lives
// on the pages, not in the menu.
interface Props { current?: string }
const { current = "" } = Astro.props;
const calendly = "https://calendly.com/adesikan/15min";
const links = [
  { href: "/practice", label: "Overview" },
  { href: "/approach", label: "Approach" },
  { href: "/clubs", label: "Clubs" },
  { href: "/federated", label: "Case study" },
  { href: "/about", label: "About" },
];
const base = "transition-colors hover:text-[color:var(--color-paper)]";
---
<header class="sticky top-0 z-50 -mx-6 md:-mx-10 px-6 md:px-10 py-4 mb-16 md:mb-24 flex items-center justify-between gap-6 bg-[color:var(--color-ink)]/85 backdrop-blur-md border-b border-[color:var(--color-line)]/60">
  <a href="/" class="text-[11px] md:text-xs tracking-[0.22em] uppercase text-[color:var(--color-accent)]" style="font-family: var(--font-display)">Citizen of Nowhere</a>
  <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 md:gap-x-7 text-xs md:text-sm text-[color:var(--color-muted)] justify-end" style="font-family: var(--font-display)">
    {links.map((l) => (
      <a href={l.href} class={base} aria-current={current === l.href ? "page" : undefined} style={current === l.href ? "color: var(--color-paper)" : undefined}>{l.label}</a>
    ))}
    <a href={calendly} target="_blank" rel="noopener" class="border border-[color:var(--color-accent)] text-[color:var(--color-accent)] hover:bg-[color:var(--color-accent)] hover:text-[color:var(--color-ink)] transition-colors px-3 py-1.5 rounded-sm">Book a call</a>
  </nav>
</header>
